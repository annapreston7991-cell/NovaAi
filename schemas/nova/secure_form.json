{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NovaSecureFormCard",
  "type": "object",
  "additionalProperties": false,
  "required": ["formId", "title", "target", "fields"],
  "properties": {
    "formId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mcp_credentials", "voice:elevenlabs", "secret"]
        },
        "server": {
          "type": "string",
          "maxLength": 64
        },
        "key": {
          "type": "string",
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": ["text", "email", "password"]
          },
          "required": {
            "type": "boolean"
          },
          "autocomplete": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "submitLabel": {
      "type": "string",
      "maxLength": 40
    },
    "expiresAt": {
      "type": ["string", "null"]
    }
  }
}
