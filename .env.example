# LLYVerse / Nova example environment file.
# Copy the lines you need into .env (never commit .env). Leave a value empty to keep
# that feature off. No real values belong in this file.

# ---------------------------------------------------------------------------
# Nova layout v3 (simpler menus) is ON for everyone by default.
# Kill switch: set NOVA_UI_V3=false and restart to put everyone back on the old
# layout. Anyone can also use /novaai?ui=v2 or Settings > "Switch back to the old
# layout"; the owner can still preview the new one with /novaai?ui=v3.
# ---------------------------------------------------------------------------
NOVA_UI_V3=

# ---------------------------------------------------------------------------
# Nova encryption keys (created automatically in .env on first start if missing).
# Plugin tokens are encrypted with NOVA_SECRETS_KEY. Do not change it once set,
# or every saved connection has to be made again.
# ---------------------------------------------------------------------------
NOVA_SECRETS_KEY=
NOVA_BACKUP_KEY=

# ---------------------------------------------------------------------------
# Nova plugins. A plugin only appears for members when ALL its keys are set.
# See docs/nova-plugins.md for where to create each app and which redirect URL
# to paste. Setup status: Admin > "Nova Plugins Setup".
# ---------------------------------------------------------------------------
# Public address used to build OAuth redirect URLs (no trailing slash).
NOVA_PLUGINS_BASE_URL=https://llyverse.org

# Google: one OAuth client for Gmail, Calendar, Drive, Docs and YouTube
NOVA_PLUGIN_GOOGLE_CLIENT_ID=
NOVA_PLUGIN_GOOGLE_CLIENT_SECRET=

# GitHub
NOVA_PLUGIN_GITHUB_CLIENT_ID=
NOVA_PLUGIN_GITHUB_CLIENT_SECRET=

# Notion (public integration)
NOVA_PLUGIN_NOTION_CLIENT_ID=
NOVA_PLUGIN_NOTION_CLIENT_SECRET=

# Slack
NOVA_PLUGIN_SLACK_CLIENT_ID=
NOVA_PLUGIN_SLACK_CLIENT_SECRET=

# Discord
NOVA_PLUGIN_DISCORD_CLIENT_ID=
NOVA_PLUGIN_DISCORD_CLIENT_SECRET=

# Spotify
NOVA_PLUGIN_SPOTIFY_CLIENT_ID=
NOVA_PLUGIN_SPOTIFY_CLIENT_SECRET=

# Dropbox (app key / app secret)
NOVA_PLUGIN_DROPBOX_CLIENT_ID=
NOVA_PLUGIN_DROPBOX_CLIENT_SECRET=

# Todoist
NOVA_PLUGIN_TODOIST_CLIENT_ID=
NOVA_PLUGIN_TODOIST_CLIENT_SECRET=

# Shopify (each member connects their own shop)
NOVA_PLUGIN_SHOPIFY_CLIENT_ID=
NOVA_PLUGIN_SHOPIFY_CLIENT_SECRET=

# X (Twitter), OAuth 2.0 with PKCE
NOVA_PLUGIN_X_CLIENT_ID=
NOVA_PLUGIN_X_CLIENT_SECRET=

# Reddit ("web app")
NOVA_PLUGIN_REDDIT_CLIENT_ID=
NOVA_PLUGIN_REDDIT_CLIENT_SECRET=

# Weather (OpenWeather). One site key; members do not connect anything.
NOVA_PLUGIN_OPENWEATHER_API_KEY=

# Owner-only, read-only plugins (never shown to members)
# Stripe restricted key with READ access to Balance, Charges, Subscriptions only.
NOVA_PLUGIN_STRIPE_READ_KEY=
# Cloudflare API token with Zone:Read and DNS:Read only.
NOVA_PLUGIN_CLOUDFLARE_READ_TOKEN=

# Wikipedia needs no key and is always available.
