<%#
  Nova Plugins (Settings > Plugins & connections). A member connects their OWN accounts.
  Only plugins the site has set up are listed (unconfigured ones are hidden; setup status
  is on the admin page). Tokens never reach this page.
%>
<% const safeError = String(error || '').replace(/https?:\/\/\S+|www\.\S+/gi, '').replace(/[^\w\s.,:;'()\-]/g, '').slice(0, 200); %>
<% const connectedPlugin = (plugins || []).find(function (p) { return p.id === connected; }); %>
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Plugins &amp; connections · Nova | LLYVerse</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/output.css?v=20261017v5" />
  <script src="/js/lucide.min.js"></script>
  <style>
    :root { color-scheme: dark; }
    body { margin: 0; background: #020617; color: #e2e8f0; font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif; }
    a { color: #67e8f9; }
    .wrap { max-width: 920px; margin: 0 auto; padding: 20px 16px 64px; }
    header.top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 14px; border-radius: 12px; border: 1px solid #334155; color: #e2e8f0; text-decoration: none; }
    .back:hover { background: #0f172a; }
    h1 { font-size: 26px; margin: 18px 0 6px; color: #f8fafc; }
    .lead { color: #cbd5e1; margin: 0 0 18px; max-width: 680px; }
    .banner { padding: 12px 14px; border-radius: 12px; margin: 0 0 16px; }
    .banner.ok { background: #052e2b; border: 1px solid #10b981; color: #d1fae5; }
    .banner.err { background: #3b0a14; border: 1px solid #f43f5e; color: #ffe4e6; }
    .safety { background: #0b1220; border: 1px solid #1e293b; border-radius: 14px; padding: 14px 16px; margin-bottom: 20px; color: #cbd5e1; }
    .safety strong { color: #f8fafc; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
    .card { background: #0b1220; border: 1px solid #1e293b; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .card h2 { margin: 0; font-size: 17px; color: #f8fafc; }
    .meta { font-size: 13px; color: #aab6c8; }
    .desc { margin: 0; color: #cbd5e1; font-size: 14px; }
    .status { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; }
    .status.on { color: #6ee7b7; }
    .status.off { color: #aab6c8; }
    ul.actions { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #cbd5e1; }
    .tag { display: inline-block; min-width: 72px; font-size: 12px; font-weight: 700; padding: 1px 6px; border-radius: 6px; margin-right: 6px; }
    .tag.read { background: #083344; color: #a5f3fc; }
    .tag.write { background: #3b2507; color: #fde68a; }
    .row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; }
    .btn { min-height: 44px; padding: 8px 16px; border-radius: 12px; border: 0; font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .btn.primary { background: #06b6d4; color: #031016; }
    .btn.primary:hover { background: #22d3ee; }
    .btn.quiet { background: transparent; color: #e2e8f0; border: 1px solid #475569; }
    .btn.quiet:hover { background: #1e293b; }
    label.shop { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #cbd5e1; width: 100%; }
    label.shop input { min-height: 44px; padding: 8px 10px; border-radius: 10px; border: 1px solid #475569; background: #020617; color: #f8fafc; font-size: 16px; }
    .empty { padding: 24px; border: 1px dashed #334155; border-radius: 16px; color: #cbd5e1; }
    .owner { font-size: 12px; font-weight: 700; color: #f5d0fe; background: #3b0764; padding: 1px 7px; border-radius: 6px; }
    *:focus-visible { outline: 2px solid #22d3ee; outline-offset: 2px; }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="top">
      <a class="back" href="/novaai"><i data-lucide="arrow-left" aria-hidden="true" style="width:18px;height:18px"></i><span>Back to Nova</span></a>
      <a class="back" href="/nova/how-it-works">How Nova works</a>
    </header>

    <main>
      <h1>Plugins &amp; connections</h1>
      <p class="lead">Connect your own accounts so Nova can look things up for you. Each connection is yours only: it is encrypted, never shared with anyone else, and you can disconnect it at any time.</p>

      <% if (connectedPlugin) { %>
        <div class="banner ok" role="status"><strong><%= connectedPlugin.name %></strong> is connected. Ask Nova about it in chat.</div>
      <% } %>
      <% if (safeError) { %>
        <div class="banner err" role="alert">Could not connect: <%= safeError %></div>
      <% } %>

      <div class="safety">
        <strong>Nova asks first.</strong> Reading (searching mail, listing issues, checking the weather) happens straight away.
        Anything that sends, posts, creates or deletes shows a card in chat with exactly what will happen, and only runs after you press Confirm.
      </div>

      <% if (!plugins || plugins.length === 0) { %>
        <div class="empty">No plugins are available yet. Check back soon.</div>
      <% } else { %>
      <div class="grid">
        <% plugins.forEach(function (p) { %>
        <section class="card" aria-labelledby="plugin-<%= p.id %>">
          <div>
            <h2 id="plugin-<%= p.id %>"><%= p.name %> <% if (p.ownerOnly) { %><span class="owner">Owner only</span><% } %></h2>
            <div class="meta"><%= p.category %></div>
          </div>
          <p class="desc"><%= p.description %></p>
          <div class="status <%= p.connected ? 'on' : 'off' %>">
            <% if (!p.needsAccount) { %>Ready, no account needed<% } else if (p.connected) { %>Connected<%= p.accountLabel ? ' as ' + p.accountLabel : '' %><% } else { %>Not connected<% } %>
          </div>
          <ul class="actions" aria-label="What Nova can do with <%= p.name %>">
            <% p.actions.forEach(function (a) { %>
              <li><span class="tag <%= a.kind === 'write' ? 'write' : 'read' %>"><%= a.kind === 'write' ? 'Asks first' : 'Reads' %></span><%= a.title %></li>
            <% }); %>
          </ul>
          <% if (p.needsAccount) { %>
          <div class="row">
            <% if (p.connected) { %>
              <button type="button" class="btn quiet" data-disconnect="<%= p.id %>" data-name="<%= p.name %>">Disconnect</button>
            <% } else if (p.needsShop) { %>
              <form class="row" method="get" action="/api/nova/plugins/<%= p.id %>/connect" data-shop-form>
                <label class="shop">Your shop address
                  <input name="shop" required placeholder="your-shop.myshopify.com" pattern="[a-zA-Z0-9][a-zA-Z0-9\-]*\.myshopify\.com" autocomplete="off" />
                </label>
                <button type="submit" class="btn primary">Connect <%= p.name %></button>
              </form>
            <% } else { %>
              <a class="btn primary" href="/api/nova/plugins/<%= p.id %>/connect">Connect <%= p.name %></a>
            <% } %>
          </div>
          <% } %>
        </section>
        <% }); %>
      </div>
      <% } %>
    </main>
  </div>

  <script>
    (function () {
      document.addEventListener('click', async function (e) {
        var btn = e.target.closest('[data-disconnect]');
        if (!btn) return;
        var name = btn.getAttribute('data-name');
        if (!window.confirm('Disconnect ' + name + '? Nova will forget this connection.')) return;
        btn.disabled = true;
        btn.textContent = 'Disconnecting…';
        try {
          var res = await fetch('/api/nova/plugins/' + encodeURIComponent(btn.getAttribute('data-disconnect')) + '/disconnect', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: '{}'
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok || data.success === false) throw new Error(data.error || 'Request failed');
          window.location.href = '/novaai/plugins';
        } catch (err) {
          btn.disabled = false;
          btn.textContent = 'Disconnect';
          window.alert('Could not disconnect: ' + err.message);
        }
      });
      // Navigate instead of submitting: the site CSP (form-action 'self') would block the
      // redirect on to Shopify if this were a real form submission.
      document.addEventListener('submit', function (e) {
        var form = e.target.closest('[data-shop-form]');
        if (!form) return;
        e.preventDefault();
        var shop = form.querySelector('input[name="shop"]').value.trim().toLowerCase();
        window.location.href = form.getAttribute('action') + '?shop=' + encodeURIComponent(shop);
      });
      if (window.lucide) window.lucide.createIcons();
    })();
  </script>
</body>
</html>
