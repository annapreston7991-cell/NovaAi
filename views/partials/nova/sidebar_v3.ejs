<%#
  Nova layout v3 sidebar (NOVA-UI-3). Rendered from services/nova_menu.js.
  Keeps id="novaSidebar" and the live list ids (#novaAgentList, #novaRoomList,
  #novaSectionsContainer, #novaConversationList) so app.js and gestures.js keep
  working (phone drawer, swipe, unread badges, switching chats).
  The Admin group only exists in `menu` for the owner (filtered on the server).
%>
<nav id="novaSidebar" class="nova-sidebar nova-v3-sidebar" aria-label="Nova menu">
  <div class="nova-v3-brand">
    <button type="button" class="nova-v3-brand-btn" data-nova-v3="open-group:explore" aria-label="Nova. Open Explore">
      <img src="/images/nova-icon.jpg?v=20260925" alt="" class="nova-v3-logo" />
      <span class="nova-v3-brand-name">Nova</span>
    </button>
    <button type="button" class="nova-v3-icon-btn nova-v3-phone-only" data-nova-v3="close-drawer" aria-label="Close menu">
      <i data-lucide="x" aria-hidden="true"></i>
    </button>
  </div>

  <div class="nova-v3-scroll">
    <% (menu || []).forEach(function (group) { %>
    <section class="nova-v3-group" data-group-id="<%= group.id %>">
      <h2 class="nova-v3-group-heading">
        <button type="button" class="nova-v3-group-btn" aria-expanded="<%= group.id === 'chats' ? 'true' : 'false' %>" aria-controls="novaV3Group-<%= group.id %>" id="novaV3GroupBtn-<%= group.id %>">
          <i data-lucide="<%= group.icon %>" aria-hidden="true"></i>
          <span><%= group.label %></span>
          <i data-lucide="chevron-down" class="nova-v3-chevron" aria-hidden="true"></i>
        </button>
      </h2>
      <div class="nova-v3-group-body" id="novaV3Group-<%= group.id %>" role="group" aria-labelledby="novaV3GroupBtn-<%= group.id %>"<% if (group.id !== 'chats') { %> hidden<% } %>>
        <% group.items.forEach(function (item) { %>
          <% if (item.list === 'personas') { %>
            <div class="nova-v3-list-label"><%= item.label %> <span id="novaTotalUnreadBadge" class="nova-unread-badge hidden" aria-live="polite">0 unread</span></div>
            <div id="novaAgentList" class="nova-v3-list" role="listbox" aria-label="Personas">
              <% const agents = (typeof bootstrap !== 'undefined' && bootstrap && bootstrap.agents && bootstrap.agents.length) ? bootstrap.agents : [
                { id: 'nova', name: 'Nova', title: 'Guide, builder & companion', avatarUrl: '/images/nova-icon.jpg', color: '#06b6d4' },
                { id: 'astra', name: 'Astra', title: 'Wonder & Synthesis', avatarUrl: '/images/nova-icon.jpg', color: '#c084fc' },
                { id: 'astaria', name: 'Astaria', title: 'Analyst & Logic', avatarUrl: '/images/nova-icon.jpg', color: '#10b981' }
              ]; %>
              <% agents.filter(function (a) { return !a.hidden; }).forEach(function (agent, idx) { %>
                <%- include('agent_row', { agent: agent, isActive: idx === 0 }) %>
              <% }); %>
            </div>
          <% } else if (item.list === 'rooms') { %>
            <div class="nova-v3-list-label"><%= item.label %></div>
            <div id="novaRoomList" class="nova-v3-list"></div>
          <% } else if (item.list === 'conversations') { %>
            <div class="nova-v3-list-label"><%= item.label %></div>
            <div id="novaSectionsContainer" class="nova-v3-list"></div>
            <div id="novaConversationList" class="nova-v3-list" role="list" aria-label="Recent conversations"></div>
          <% } else { %>
            <%- include('v3_item', { item: item }) %>
          <% } %>
        <% }); %>
      </div>
    </section>
    <% }); %>
  </div>

  <div class="nova-v3-footer">
    <%- include('account_button', { user: typeof user !== 'undefined' ? user : null }) %>
  </div>
</nav>
