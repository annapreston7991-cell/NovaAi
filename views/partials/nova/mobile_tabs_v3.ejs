<%#
  Nova layout v3 on phones (NOVA-UI-4): bottom bar + one sheet per menu.
  Chats opens the chat list drawer (the sidebar). Everything is at most 2 taps away.
  Same items as the desktop sidebar (services/nova_menu.js). Admin only for the owner.
%>
<nav id="novaV3BottomBar" class="nova-v3-bottombar" aria-label="Nova menu">
  <% (menu || []).forEach(function (group) { %>
  <button type="button" class="nova-v3-tab" data-nova-v3="<%= group.id === 'chats' ? 'drawer' : 'sheet:' + group.id %>" aria-label="<%= group.label %>"<% if (group.id !== 'chats') { %> aria-haspopup="dialog" aria-controls="novaV3Sheet-<%= group.id %>"<% } %>>
    <i data-lucide="<%= group.icon %>" aria-hidden="true"></i>
    <span><%= group.label %></span>
  </button>
  <% }); %>
</nav>

<div id="novaV3SheetBackdrop" class="nova-v3-backdrop" hidden></div>
<% (menu || []).filter(function (g) { return g.id !== 'chats'; }).forEach(function (group) { %>
<div id="novaV3Sheet-<%= group.id %>" class="nova-v3-sheet" role="dialog" aria-modal="true" aria-labelledby="novaV3SheetTitle-<%= group.id %>" hidden>
  <div class="nova-v3-sheet-handle" aria-hidden="true"></div>
  <div class="nova-v3-sheet-head">
    <h2 id="novaV3SheetTitle-<%= group.id %>"><%= group.label %></h2>
    <button type="button" class="nova-v3-icon-btn" data-nova-v3="close-sheet" aria-label="Close <%= group.label %>">
      <i data-lucide="x" aria-hidden="true"></i>
    </button>
  </div>
  <p class="nova-v3-sheet-hint"><%= group.hint %></p>
  <div class="nova-v3-sheet-items">
    <% group.items.forEach(function (item) { if (item.list) return; %>
      <%- include('v3_item', { item: item }) %>
    <% }); %>
  </div>
</div>
<% }); %>
