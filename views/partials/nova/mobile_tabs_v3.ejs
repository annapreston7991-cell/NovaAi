<!-- NOVA-UI-4: Mobile Bottom Bar (5 Menu Buttons) + Bottom Sheets -->
<nav id="novaV3MobileBottomBar" class="md:hidden fixed bottom-0 left-0 right-0 bg-dark-950/98 backdrop-blur-xl border-t border-white/10 z-40 px-2 py-1.5 flex items-center justify-around select-none pb-safe">
  <button type="button" class="nova-v3-mobile-tab flex flex-col items-center justify-center p-1.5 min-w-[56px] min-h-[44px] text-cyan-400 font-medium active:scale-95 transition" data-sheet-target="sheet-chats">
    <i data-lucide="message-square" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Chats</span>
  </button>
  <button type="button" class="nova-v3-mobile-tab flex flex-col items-center justify-center p-1.5 min-w-[56px] min-h-[44px] text-slate-400 hover:text-white font-medium active:scale-95 transition" data-sheet-target="sheet-workspace">
    <i data-lucide="briefcase" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Workspace</span>
  </button>
  <button type="button" class="nova-v3-mobile-tab flex flex-col items-center justify-center p-1.5 min-w-[56px] min-h-[44px] text-slate-400 hover:text-white font-medium active:scale-95 transition" data-sheet-target="sheet-explore">
    <i data-lucide="compass" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Explore</span>
  </button>
  <button type="button" class="nova-v3-mobile-tab flex flex-col items-center justify-center p-1.5 min-w-[56px] min-h-[44px] text-slate-400 hover:text-white font-medium active:scale-95 transition" data-sheet-target="sheet-settings">
    <i data-lucide="settings" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Settings</span>
  </button>
  <% if (typeof isOwnerAdmin !== 'undefined' && isOwnerAdmin) { %>
  <button type="button" class="nova-v3-mobile-tab flex flex-col items-center justify-center p-1.5 min-w-[56px] min-h-[44px] text-purple-400 font-medium active:scale-95 transition" data-sheet-target="sheet-admin">
    <i data-lucide="shield-alert" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Admin</span>
  </button>
  <% } %>
</nav>

<!-- Mobile Bottom Sheets Container & Backdrop -->
<div id="novaV3SheetBackdrop" class="md:hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200"></div>

<!-- Mobile Sheets -->
<div id="novaV3SheetsContainer" class="md:hidden fixed bottom-0 left-0 right-0 z-50 pointer-events-none">
  <!-- Sheet: Chats -->
  <div id="sheet-chats" class="nova-v3-bottom-sheet hidden transform translate-y-full transition-transform duration-200 ease-out bg-slate-900 border-t border-cyan-500/30 rounded-t-2xl p-4 space-y-3 pointer-events-auto pb-safe">
    <div class="w-12 h-1 bg-white/20 rounded-full mx-auto mb-2"></div>
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white flex items-center gap-2">
        <i data-lucide="message-square" class="w-4 h-4 text-cyan-400"></i>
        <span>Chats & Conversations</span>
      </h3>
      <button type="button" class="close-sheet-btn p-1 text-slate-400 hover:text-white">✕</button>
    </div>
    <div class="grid grid-cols-2 gap-2 text-xs">
      <button type="button" data-nova-action="new-chat" class="p-3 rounded-xl bg-cyan-600 text-white font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>New Chat</span>
      </button>
      <button type="button" data-nova-action="open-palette" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="search" class="w-4 h-4 text-cyan-400"></i>
        <span>Search</span>
      </button>
      <button type="button" data-nova-action="create-council-room" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="users" class="w-4 h-4 text-indigo-400"></i>
        <span>Council Room</span>
      </button>
      <button type="button" data-nova-action="import-local-storage" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="download-cloud" class="w-4 h-4 text-emerald-400"></i>
        <span>Import Chats</span>
      </button>
    </div>
  </div>

  <!-- Sheet: Workspace -->
  <div id="sheet-workspace" class="nova-v3-bottom-sheet hidden transform translate-y-full transition-transform duration-200 ease-out bg-slate-900 border-t border-purple-500/30 rounded-t-2xl p-4 space-y-3 pointer-events-auto pb-safe">
    <div class="w-12 h-1 bg-white/20 rounded-full mx-auto mb-2"></div>
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white flex items-center gap-2">
        <i data-lucide="briefcase" class="w-4 h-4 text-purple-400"></i>
        <span>Workspace & Tools</span>
      </h3>
      <button type="button" class="close-sheet-btn p-1 text-slate-400 hover:text-white">✕</button>
    </div>
    <div class="grid grid-cols-2 gap-2 text-xs">
      <button type="button" data-nova-action="open-memory-view" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="brain" class="w-4 h-4 text-cyan-400"></i>
        <span>Memory Vault</span>
      </button>
      <button type="button" data-nova-action="toggle-new-routine" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="calendar" class="w-4 h-4 text-blue-400"></i>
        <span>Routines</span>
      </button>
      <button type="button" data-nova-action="open-agent-settings" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="sliders" class="w-4 h-4 text-indigo-400"></i>
        <span>Personas</span>
      </button>
      <button type="button" data-nova-action="refresh-actions" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="activity" class="w-4 h-4 text-emerald-400"></i>
        <span>Activity Log</span>
      </button>
    </div>
  </div>

  <!-- Sheet: Explore -->
  <div id="sheet-explore" class="nova-v3-bottom-sheet hidden transform translate-y-full transition-transform duration-200 ease-out bg-slate-900 border-t border-blue-500/30 rounded-t-2xl p-4 space-y-3 pointer-events-auto pb-safe">
    <div class="w-12 h-1 bg-white/20 rounded-full mx-auto mb-2"></div>
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white flex items-center gap-2">
        <i data-lucide="compass" class="w-4 h-4 text-blue-400"></i>
        <span>Explore LLYVerse</span>
      </h3>
      <button type="button" class="close-sheet-btn p-1 text-slate-400 hover:text-white">✕</button>
    </div>
    <div class="grid grid-cols-2 gap-2 text-xs">
      <a href="/" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">LLYVerse Home</a>
      <a href="/aurastream" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">AuraStream</a>
      <a href="/studio" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">Studio</a>
      <a href="/academy" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">Academy</a>
      <a href="/store" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">Store</a>
      <a href="/blog" class="p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px]">Community</a>
    </div>
  </div>

  <!-- Sheet: Settings -->
  <div id="sheet-settings" class="nova-v3-bottom-sheet hidden transform translate-y-full transition-transform duration-200 ease-out bg-slate-900 border-t border-slate-500/30 rounded-t-2xl p-4 space-y-3 pointer-events-auto pb-safe">
    <div class="w-12 h-1 bg-white/20 rounded-full mx-auto mb-2"></div>
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white flex items-center gap-2">
        <i data-lucide="settings" class="w-4 h-4 text-slate-400"></i>
        <span>Settings & Preferences</span>
      </h3>
      <button type="button" class="close-sheet-btn p-1 text-slate-400 hover:text-white">✕</button>
    </div>
    <div class="space-y-2 text-xs">
      <button type="button" data-nova-action="open-settings" class="w-full p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px] text-left">
        <i data-lucide="sliders-horizontal" class="w-4 h-4 text-cyan-400"></i>
        <span>General & Theme Preferences</span>
      </button>
      <button type="button" data-nova-action="send-test-push" class="w-full p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px] text-left">
        <i data-lucide="bell" class="w-4 h-4 text-purple-400"></i>
        <span>Push Notifications Setup</span>
      </button>
      <button type="button" data-nova-action="install-app" class="w-full p-3 rounded-xl bg-white/5 text-slate-200 font-semibold flex items-center gap-2 min-h-[44px] text-left">
        <i data-lucide="download" class="w-4 h-4 text-emerald-400"></i>
        <span>Install Standalone PWA</span>
      </button>
    </div>
  </div>

  <% if (typeof isOwnerAdmin !== 'undefined' && isOwnerAdmin) { %>
  <!-- Sheet: Admin (Founder Only) -->
  <div id="sheet-admin" class="nova-v3-bottom-sheet hidden transform translate-y-full transition-transform duration-200 ease-out bg-slate-900 border-t border-purple-500/50 rounded-t-2xl p-4 space-y-3 pointer-events-auto pb-safe">
    <div class="w-12 h-1 bg-purple-400/40 rounded-full mx-auto mb-2"></div>
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-purple-300 flex items-center gap-2">
        <i data-lucide="shield-alert" class="w-4 h-4 text-purple-400"></i>
        <span>Founder Admin Suite</span>
      </h3>
      <button type="button" class="close-sheet-btn p-1 text-slate-400 hover:text-white">✕</button>
    </div>
    <div class="grid grid-cols-2 gap-2 text-xs">
      <button type="button" data-nova-action="reconnect-screen" class="p-3 rounded-xl bg-purple-500/10 text-purple-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="monitor" class="w-4 h-4 text-cyan-400"></i>
        <span>Live Screen</span>
      </button>
      <button type="button" data-nova-action="refresh-computer-files" class="p-3 rounded-xl bg-purple-500/10 text-purple-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="folder-git-2" class="w-4 h-4 text-indigo-400"></i>
        <span>Files</span>
      </button>
      <a href="/admin" class="p-3 rounded-xl bg-purple-500/10 text-purple-200 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="terminal" class="w-4 h-4 text-purple-400"></i>
        <span>Console</span>
      </a>
      <button type="button" data-nova-action="stop-nova" class="p-3 rounded-xl bg-rose-500/10 text-rose-300 font-semibold flex items-center gap-2 min-h-[44px]">
        <i data-lucide="octagon" class="w-4 h-4 text-rose-400"></i>
        <span>Emergency Stop</span>
      </button>
    </div>
  </div>
  <% } %>
</div>
