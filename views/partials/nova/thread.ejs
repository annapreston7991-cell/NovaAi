<!-- Nova Thread Panel / Mobile Sheet (§4.8) -->
<aside
  id="novaThreadPanel"
  class="nova-thread-panel hidden fixed inset-0 z-40 md:static md:w-[360px] md:shrink-0 bg-[#0d101b] border-l border-white/10 flex flex-col"
  aria-label="Message thread"
>
  <header class="h-14 px-4 border-b border-white/10 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-2">
      <i data-lucide="message-square-reply" class="w-4 h-4 text-cyan-400"></i>
      <h2 class="text-sm font-bold text-white">Thread</h2>
      <span id="novaThreadReplyCount" class="text-[11px] font-mono text-slate-400">(0 replies)</span>
    </div>
    <button
      type="button"
      data-nova-action="close-thread"
      class="p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300"
      aria-label="Close thread"
    >
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </header>

  <div class="flex-1 overflow-y-auto p-4 space-y-3" id="novaThreadStream">
    <!-- Parent message card -->
    <div id="novaThreadParentCard" class="p-3 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-200"></div>
    <div class="border-t border-white/10 pt-2 text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Replies</div>
    <div id="novaThreadRepliesList" class="space-y-2.5"></div>
  </div>

  <form id="novaThreadForm" class="p-3 border-t border-white/10 bg-black/30 flex items-center gap-2">
    <input
      type="text"
      id="novaThreadInput"
      placeholder="Reply in thread..."
      class="flex-1 px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400"
      aria-label="Reply in thread"
    />
    <button
      type="submit"
      class="px-3 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition"
    >
      Reply
    </button>
  </form>
</aside>
