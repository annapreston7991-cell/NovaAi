<!-- Install Nova Button & iOS Add-to-Home-Screen Sheet (§3.6, §14) -->
<div class="nova-install-wrap" data-nova-install-container>
  <button
    type="button"
    data-nova-action="install-app"
    class="nova-install-button w-full flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-500/35 text-xs font-semibold text-cyan-200 transition min-h-[44px]"
    aria-label="Install Nova standalone application"
  >
    <span class="flex items-center gap-2">
      <i data-lucide="download" class="w-4 h-4 text-cyan-400"></i>
      <span>Install Nova</span>
    </span>
    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-black/40 text-cyan-300 border border-cyan-500/30">App</span>
  </button>
</div>
