<!-- Stop Nova Kill-Switch Button (§15.2) -->
<button
  type="button"
  class="nova-stop-button"
  data-nova-action="stop-nova"
  title="Immediately stop all running Nova tasks, terminal sessions, and routines"
  aria-label="Stop Nova immediately"
>
  <i data-lucide="octagon-x" class="w-3.5 h-3.5"></i>
  <span>Stop Nova</span>
</button>
