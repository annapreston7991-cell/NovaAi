<!-- Nova Top-Left Popup Menu (triggered by clicking Nova's icon at the top of the screen) -->
<nav
  id="novaMobileTabs"
  class="nova-top-menu hidden is-hidden fixed top-14 left-4 z-[90] w-64 rounded-2xl bg-slate-950/95 backdrop-blur-xl border border-cyan-500/30 shadow-2xl p-2 space-y-1 text-xs"
  aria-label="Nova quick menu"
>
  <div class="px-2.5 py-1.5 border-b border-white/10 flex items-center justify-between">
    <span class="font-mono text-[10px] uppercase tracking-wider text-cyan-300 font-bold">Nova Workspace Menu</span>
    <button
      type="button"
      data-nova-action="close-nova-menu"
      class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-white/5"
      aria-label="Close Nova menu"
    >✕</button>
  </div>

  <button
    type="button"
    data-nova-mobile-tab="chats"
    class="w-full px-3 py-2.5 rounded-xl hover:bg-white/10 flex items-center gap-3 text-slate-100 font-semibold text-left transition"
  >
    <i data-lucide="message-square" class="w-4 h-4 text-cyan-400"></i>
    <span>Chats &amp; Personas</span>
  </button>

  <% if (typeof isOwnerAdmin !== 'undefined' && isOwnerAdmin) { %>
  <button
    type="button"
    data-nova-mobile-tab="computer"
    class="w-full px-3 py-2.5 rounded-xl hover:bg-white/10 flex items-center gap-3 text-slate-100 font-semibold text-left transition"
  >
    <i data-lucide="monitor" class="w-4 h-4 text-emerald-400"></i>
    <span>Computer</span>
  </button>
  <% } %>

  <button
    type="button"
    data-nova-mobile-tab="routines"
    class="w-full px-3 py-2.5 rounded-xl hover:bg-white/10 flex items-center gap-3 text-slate-100 font-semibold text-left transition"
  >
    <i data-lucide="clock" class="w-4 h-4 text-amber-400"></i>
    <span>Routines</span>
  </button>

  <button
    type="button"
    data-nova-action="open-memory-modal"
    class="w-full px-3 py-2.5 rounded-xl hover:bg-white/10 flex items-center gap-3 text-slate-100 font-semibold text-left transition"
  >
    <i data-lucide="brain" class="w-4 h-4 text-purple-400"></i>
    <span>Memory Vault</span>
  </button>

  <button
    type="button"
    data-nova-action="open-settings-modal"
    class="w-full px-3 py-2.5 rounded-xl hover:bg-white/10 flex items-center gap-3 text-slate-100 font-semibold text-left transition"
  >
    <i data-lucide="settings" class="w-4 h-4 text-cyan-300"></i>
    <span>Nova Settings</span>
  </button>

  <button
    type="button"
    data-nova-mobile-tab="more"
    class="w-full px-3 py-2.5 rounded-xl hover:bg-white/10 flex items-center gap-3 text-slate-100 font-semibold text-left transition"
  >
    <i data-lucide="grid" class="w-4 h-4 text-slate-300"></i>
    <span>More LLYVerse…</span>
  </button>

  <div class="pt-1.5 mt-1 border-t border-white/10 flex items-center justify-between px-2.5 py-1 text-[11px] text-slate-400">
    <a href="/" class="hover:text-cyan-300">← LLYVerse Home</a>
    <a href="/nova/how-it-works" class="hover:text-cyan-300">How Nova works</a>
  </div>
</nav>

<!-- Mobile "More" Sheet (Mail, Fleet Telemetry, AuraStream, Settings) (§8.1) -->
<div id="novaMobileMoreSheet" class="nova-command-backdrop is-hidden hidden" role="dialog" aria-modal="true" aria-labelledby="novaMobileMoreTitle">
  <div class="w-full max-w-md rounded-t-2xl sm:rounded-2xl bg-slate-900 border border-white/15 shadow-2xl p-5 space-y-4 text-xs mt-auto sm:my-auto pb-safe">
    <div class="w-10 h-1 rounded-full bg-white/20 mx-auto mb-1"></div>
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <h2 id="novaMobileMoreTitle" class="text-sm font-bold text-white">More LLYVerse &amp; Nova</h2>
      <button type="button" data-nova-action="close-more-sheet" class="p-2 rounded-lg bg-white/5 text-slate-400 hover:text-white min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Close More menu">✕</button>
    </div>
    <div class="grid grid-cols-2 gap-2.5">
      <a href="/mail" class="p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center gap-3 text-slate-100 font-semibold min-h-[48px]">
        <i data-lucide="mail" class="w-4 h-4 text-cyan-400"></i>
        <span>LLY Mail</span>
      </a>
      <a href="/portal#telemetry" class="p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center gap-3 text-slate-100 font-semibold min-h-[48px]">
        <i data-lucide="cpu" class="w-4 h-4 text-emerald-400"></i>
        <span>Fleet Telemetry</span>
      </a>
      <a href="/aurastream" class="p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center gap-3 text-slate-100 font-semibold min-h-[48px]">
        <i data-lucide="radio" class="w-4 h-4 text-purple-400"></i>
        <span>AuraStream</span>
      </a>
      <button type="button" data-nova-action="open-settings" class="p-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center gap-3 text-slate-100 font-semibold min-h-[48px] text-left">
        <i data-lucide="settings" class="w-4 h-4 text-cyan-400"></i>
        <span>Settings</span>
      </button>
    </div>
    <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
      <a href="/nova/how-it-works" class="hover:text-cyan-300">How Nova works</a>
      <a href="/nova/download" class="hover:text-cyan-300">Install App</a>
    </div>
  </div>
</div>
