<!-- Nova Floating Chat Widget (§3.7, §9, §12, §13 Phase 5)
     - Dark slate (#020617 / #0f172a) + cyan (#06b6d4 / #0891b2) tokens, zero !important purple overrides
     - Signed-in users: shared Nova conversation history via /api/nova
     - Guests: Nova persona only, text-only, no uploads/tools/MCP/computer, sessionStorage tab-only history,
       10 msgs/10m & 30/day per IP, ~500 token cap, links to /login?next=%2Fnovaai & /nova/how-it-works -->
<style>
  #novaCustomerWidgetWrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99990;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #novaLauncherBtn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #0f172a;
    border: 1px solid rgba(6, 182, 212, 0.45);
    border-radius: 9999px;
    padding: 6px 16px 6px 6px;
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.7);
    color: #f1f5f9;
    cursor: pointer;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.15s ease;
    min-height: 48px;
  }
  #novaLauncherBtn:hover {
    transform: translateY(-1px);
    border-color: #22d3ee;
  }
  #novaLauncherBtn:focus-visible {
    outline: 2px solid #06b6d4;
    outline-offset: 2px;
  }
  #novaWidgetContainer {
    position: fixed;
    bottom: 84px;
    right: 24px;
    width: 380px;
    max-width: calc(100vw - 32px);
    height: 520px;
    max-height: calc(100dvh - 108px);
    background: #020617;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.75);
    z-index: 99990;
    flex-direction: column;
    overflow: hidden;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: bottom right;
  }
  #novaWidgetContainer.widget-collapsed {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.95) translateY(8px);
    display: none;
  }
  #novaWidgetContainer.widget-expanded {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1) translateY(0);
    display: flex;
  }
  .nova-widget-bubble-user {
    margin-left: auto;
    max-width: 82%;
    background: #0891b2;
    color: #ffffff;
    padding: 10px 14px;
    border-radius: 16px;
    border-bottom-right-radius: 4px;
    word-break: break-word;
  }
  .nova-widget-bubble-assistant {
    max-width: 88%;
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.16);
    color: #f1f5f9;
    padding: 10px 14px;
    border-radius: 16px;
    border-top-left-radius: 4px;
    word-break: break-word;
  }
  body.page-aurastream #novaCustomerWidgetWrapper {
    bottom: 80px;
  }
  body.page-aurastream #novaWidgetContainer {
    bottom: 140px;
  }
</style>

<div
  id="novaCustomerWidgetWrapper"
  class="print:hidden"
  data-nova-widget-authenticated="<%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>"
>
  <!-- Floating Launcher Pill Button -->
  <button id="novaLauncherBtn" onclick="toggleNovaWidget()" type="button" aria-label="Chat with Nova" title="Chat with Nova">
    <div style="position: relative; width: 38px; height: 38px; border-radius: 9999px; overflow: hidden; border: 1.5px solid #06b6d4; padding: 1px; background: #020617; flex-shrink: 0;">
      <img src="/images/nova-icon.jpg?v=20260925" alt="Nova avatar" style="width: 100%; height: 100%; object-fit: cover; border-radius: 9999px;">
      <span style="position: absolute; bottom: 0; right: 0; width: 9px; height: 9px; border-radius: 9999px; background: #10b981; border: 2px solid #0f172a;"></span>
    </div>
    <div style="display: flex; flex-direction: column; text-align: left; padding-right: 4px;">
      <span style="font-size: 13px; font-weight: 700; color: #f1f5f9; line-height: 1.2;">Chat with Nova</span>
      <span style="font-size: 10px; color: #94a3b8; font-family: ui-monospace, monospace; line-height: 1.2;">
        <%= (typeof user !== 'undefined' && user) ? 'Synced with Nova App' : 'Guest Preview • Text Only' %>
      </span>
    </div>
  </button>

  <!-- Expandable Floating Chat Window -->
  <aside id="novaWidgetContainer" class="widget-collapsed" aria-label="Nova Chat">
    <!-- Top Header -->
    <div style="padding: 12px 16px; border-bottom: 1px solid rgba(148, 163, 184, 0.16); background: #0f172a; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
        <div style="position: relative; width: 34px; height: 34px; border-radius: 9999px; overflow: hidden; border: 1.5px solid #06b6d4; padding: 1px; background: #020617; flex-shrink: 0;">
          <img src="/images/nova-icon.jpg?v=20260925" alt="Nova avatar" style="width: 100%; height: 100%; object-fit: cover; border-radius: 9999px;">
        </div>
        <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
          <div style="font-size: 14px; font-weight: 600; color: #f1f5f9; display: flex; align-items: center; gap: 6px;">
            <span>Nova</span>
            <span style="font-size: 10px; font-family: ui-monospace, monospace; padding: 1px 6px; border-radius: 6px; background: rgba(6, 182, 212, 0.14); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3);">
              <%= (typeof user !== 'undefined' && user) ? 'Member' : 'Guest' %>
            </span>
          </div>
          <div style="font-size: 11px; color: #94a3b8;">
            <%= (typeof user !== 'undefined' && user) ? 'CEO & Architect • Shared History' : 'Nova only • Tab session' %>
          </div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
        <a
          href="<%= (typeof user !== 'undefined' && user) ? '/novaai' : '/register?next=%2Fnovaai' %>"
          title="Open Full Nova App"
          aria-label="Open Full Nova App"
          style="min-width: 36px; min-height: 36px; padding: 6px; border-radius: 8px; background: rgba(255, 255, 255, 0.06); color: #cbd5e1; text-decoration: none; display: flex; align-items: center; justify-content: center;"
        >
          <svg style="width: 15px; height: 15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
        </a>
        <button
          onclick="clearNovaWidgetChat()"
          type="button"
          title="Clear Conversation"
          aria-label="Clear Conversation"
          style="min-width: 36px; min-height: 36px; padding: 6px; border-radius: 8px; background: rgba(255, 255, 255, 0.06); color: #cbd5e1; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;"
        >
          <svg style="width: 15px; height: 15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
        <button
          onclick="toggleNovaWidget()"
          type="button"
          title="Close Window"
          aria-label="Close Window"
          style="min-width: 36px; min-height: 36px; padding: 6px; border-radius: 8px; background: rgba(255, 255, 255, 0.06); color: #cbd5e1; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;"
        >
          <svg style="width: 15px; height: 15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Messages Container -->
    <div
      id="novaWidgetMessages"
      role="log"
      aria-live="polite"
      style="flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 12px; font-size: 13.5px; line-height: 1.5; color: #f1f5f9;"
    >
      <div style="display: flex; align-items: flex-start; gap: 10px;">
        <div style="width: 28px; height: 28px; border-radius: 9999px; overflow: hidden; border: 1px solid rgba(6, 182, 212, 0.5); padding: 1px; background: #020617; flex-shrink: 0; margin-top: 2px;">
          <img src="/images/nova-icon.jpg?v=20260925" alt="Nova" style="width: 100%; height: 100%; object-fit: cover; border-radius: 9999px;">
        </div>
        <div class="nova-widget-bubble-assistant">
          <p style="margin: 0;">
            Hey there! I'm <strong>Nova</strong>, your companion across the LLYVerse. What can I help you explore today?
          </p>
        </div>
      </div>

      <!-- Quick Suggestion Chips -->
      <div id="novaWidgetQuickChips" style="padding-top: 4px; display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 10px; font-family: ui-monospace, monospace; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">Suggested questions:</div>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <button type="button" onclick="sendNovaWidgetPrompt('What is the LLYVerse?')" style="font-size: 12px; padding: 6px 10px; border-radius: 10px; background: #0f172a; border: 1px solid rgba(6, 182, 212, 0.3); color: #e2e8f0; cursor: pointer;">
            What is the LLYVerse?
          </button>
          <button type="button" onclick="sendNovaWidgetPrompt('Help me pick an AI prompt in the store')" style="font-size: 12px; padding: 6px 10px; border-radius: 10px; background: #0f172a; border: 1px solid rgba(6, 182, 212, 0.3); color: #e2e8f0; cursor: pointer;">
            Tell me about Prompt Store
          </button>
          <button type="button" onclick="sendNovaWidgetPrompt('How does QuikDocs AI document preview work?')" style="font-size: 12px; padding: 6px 10px; border-radius: 10px; background: #0f172a; border: 1px solid rgba(6, 182, 212, 0.3); color: #e2e8f0; cursor: pointer;">
            Help with QuikDocs
          </button>
          <button type="button" onclick="sendNovaWidgetPrompt('What is Lly Haven?')" style="font-size: 12px; padding: 6px 10px; border-radius: 10px; background: #0f172a; border: 1px solid rgba(6, 182, 212, 0.3); color: #e2e8f0; cursor: pointer;">
            What is Lly Haven?
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom Composer & Transparency Links -->
    <div style="padding: 10px 14px; background: #0f172a; border-top: 1px solid rgba(148, 163, 184, 0.16); flex-shrink: 0;">
      <form id="novaWidgetForm" onsubmit="handleNovaWidgetSubmit(event)" style="display: flex; align-items: center; gap: 8px; margin: 0;">
        <input
          type="text"
          id="novaWidgetInput"
          autocomplete="off"
          placeholder="Message Nova..."
          aria-label="Message Nova"
          style="flex: 1; background: #020617; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 10px; padding: 9px 12px; font-size: 16px; color: #f1f5f9; outline: none;"
        >
        <button
          type="submit"
          id="novaWidgetSendBtn"
          title="Send Message"
          aria-label="Send Message"
          style="min-width: 44px; min-height: 40px; padding: 8px 14px; border-radius: 10px; background: #0891b2; color: #ffffff; border: none; font-weight: 600; font-size: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"
        >
          Send
        </button>
      </form>
      <div style="display: flex; align-items: center; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-top: 8px; padding: 0 2px;">
        <a href="/nova/how-it-works" style="color: #94a3b8; text-decoration: underline;">How Nova works</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/novaai" style="color: #22d3ee; text-decoration: none; font-weight: 600;">Open Full Nova App &rarr;</a>
        <% } else { %>
          <a href="/register?next=%2Fnovaai" style="color: #22d3ee; text-decoration: none; font-weight: 600;">Create a free account &rarr;</a>
        <% } %>
      </div>
    </div>
  </aside>
</div>

<script>
(function () {
  const SESSION_KEY = 'nova_guest_widget_messages_v2';
  const wrapper = document.getElementById('novaCustomerWidgetWrapper');
  const isAuthenticated = wrapper && wrapper.getAttribute('data-nova-widget-authenticated') === 'true';

  let activeConvId = null;
  window._novaWidgetMessages = [
    { role: 'assistant', content: "Hey there! I'm Nova, your companion across the LLYVerse. What can I help you explore today?" }
  ];
  window._novaWidgetStreaming = false;

  // Load tab-only guest history or sync with /api/nova when signed in (§3.7, §12)
  function initWidgetHistory() {
    if (!isAuthenticated) {
      try {
        const raw = sessionStorage.getItem(SESSION_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            window._novaWidgetMessages = parsed;
            renderNovaWidgetChat();
          }
        }
      } catch (e) {}
      return;
    }

    // Signed-in: claim guest token if present (WO6-25)
    const claimToken = new URLSearchParams(window.location.search).get('claim_token') || sessionStorage.getItem('nova_guest_claim_token');
    if (claimToken) {
      fetch('/api/nova/claim-guest-chat', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: claimToken })
      }).then(() => {
        sessionStorage.removeItem('nova_guest_claim_token');
      }).catch(() => {});
    }

    // Signed-in: import guest session once if present, then load shared Nova conversation
    let guestToImport = null;
    try {
      const rawGuest = sessionStorage.getItem(SESSION_KEY);
      if (rawGuest) {
        const parsedGuest = JSON.parse(rawGuest);
        if (Array.isArray(parsedGuest) && parsedGuest.length > 1) {
          guestToImport = parsedGuest;
        }
        sessionStorage.removeItem(SESSION_KEY);
      }
    } catch (e) {}

    (async () => {
      try {
        if (guestToImport) {
          await fetch('/api/nova/import-local', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              conversations: [{ title: 'Imported Widget Chat', agentId: 'nova', messages: guestToImport }]
            })
          }).catch(() => {});
        }
        const bootRes = await fetch('/api/nova/bootstrap', { credentials: 'same-origin' });
        if (!bootRes.ok) return;
        const boot = await bootRes.json();
        const novaConv = (boot.conversations || []).find((c) => c.type === 'direct' && c.agentId === 'nova');
        if (novaConv) {
          activeConvId = novaConv.id;
          const mRes = await fetch('/api/nova/conversations/' + encodeURIComponent(activeConvId) + '/messages?limit=20', {
            credentials: 'same-origin'
          });
          if (mRes.ok) {
            const mData = await mRes.json();
            const msgs = (mData.messages || []).filter((m) => m.kind === 'text' || m.kind === 'result');
            if (msgs.length > 0) {
              window._novaWidgetMessages = msgs.map((m) => ({
                role: m.role,
                content: m.body || ''
              }));
              renderNovaWidgetChat();
            }
          }
        }
      } catch (e) {}
    })();
  }

  function saveGuestSessionHistory() {
    if (isAuthenticated) return;
    try {
      sessionStorage.setItem(SESSION_KEY, JSON.stringify(window._novaWidgetMessages.slice(-30)));
      let claimToken = sessionStorage.getItem('nova_guest_claim_token');
      if (!claimToken) {
        claimToken = 'claim_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        sessionStorage.setItem('nova_guest_claim_token', claimToken);
      }
      fetch('/api/nova/save-guest-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: claimToken, messages: window._novaWidgetMessages.slice(-30) })
      }).catch(() => {});
    } catch (e) {}
  }

  function checkGuestPrompt() {
    if (isAuthenticated) return;
    const GUEST_PROMPT_AFTER = window.GUEST_PROMPT_AFTER || 4;
    const userPrompts = window._novaWidgetMessages.filter((m) => m.role === 'user').length;
    if (userPrompts >= GUEST_PROMPT_AFTER && !sessionStorage.getItem('nova_guest_prompt_shown')) {
      sessionStorage.setItem('nova_guest_prompt_shown', 'true');
      const claimToken = sessionStorage.getItem('nova_guest_claim_token') || ('claim_' + Math.random().toString(36).slice(2) + Date.now().toString(36));
      sessionStorage.setItem('nova_guest_claim_token', claimToken);

      const promptDiv = document.createElement('div');
      promptDiv.className = 'nova-widget-guest-callout';
      promptDiv.style.margin = '10px 0';
      promptDiv.style.padding = '10px 14px';
      promptDiv.style.borderRadius = '12px';
      promptDiv.style.background = 'rgba(6, 182, 212, 0.12)';
      promptDiv.style.border = '1px solid rgba(6, 182, 212, 0.3)';
      promptDiv.style.fontSize = '12px';
      promptDiv.style.color = '#e2e8f0';
      promptDiv.innerHTML = "Save this chat and keep Nova's memory: <a href=\"/register?claim_token=" + encodeURIComponent(claimToken) + "&next=%2Fnovaai\" style=\"color: #22d3ee; text-decoration: underline; font-weight: 600;\">create a free account</a>";

      const container = document.getElementById('novaWidgetMessages');
      if (container) {
        container.appendChild(promptDiv);
        scrollNovaWidgetBottom();
      }
    }
  }

  // Block drag/drop or paste file uploads for guests (§12)
  const containerEl = document.getElementById('novaWidgetContainer');
  if (containerEl) {
    containerEl.addEventListener('drop', (e) => {
      if (!isAuthenticated && e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        e.preventDefault();
        appendNovaWidgetBubble('assistant', 'File uploads require signing in to the full Nova app (/login?next=%2Fnovaai).');
      }
    });
    containerEl.addEventListener('dragover', (e) => {
      if (!isAuthenticated) e.preventDefault();
    });
  }

  window.toggleNovaWidget = function () {
    const container = document.getElementById('novaWidgetContainer');
    if (!container) return;
    const isCollapsed = container.classList.contains('widget-collapsed');
    if (isCollapsed) {
      container.classList.remove('widget-collapsed');
      container.classList.add('widget-expanded');
      const input = document.getElementById('novaWidgetInput');
      if (input) setTimeout(() => input.focus(), 80);
      scrollNovaWidgetBottom();
    } else {
      container.classList.remove('widget-expanded');
      container.classList.add('widget-collapsed');
    }
  };

  window.clearNovaWidgetChat = function () {
    window._novaWidgetMessages = [
      { role: 'assistant', content: 'Chat cleared! How can I help you right now?' }
    ];
    try {
      sessionStorage.removeItem(SESSION_KEY);
    } catch (e) {}
    renderNovaWidgetChat();
  };

  function renderNovaWidgetChat() {
    const container = document.getElementById('novaWidgetMessages');
    if (!container) return;
    container.innerHTML = '';
    window._novaWidgetMessages.forEach((msg) => {
      appendNovaWidgetBubble(msg.role, msg.content, false);
    });
    scrollNovaWidgetBottom();
  }

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderSimpleMarkdown(text) {
    let html = escapeHtml(text);
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/`([^`]+)`/g, '<code style="background:#1e293b;color:#67e8f9;padding:1px 5px;border-radius:4px;font-family:monospace;font-size:12px;">$1</code>');
    html = html.replace(
      /\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g,
      '<a href="$2" style="color:#22d3ee;text-decoration:underline;">$1</a>'
    );
    html = html.replace(/\n/g, '<br>');
    return html;
  }

  function appendNovaWidgetBubble(role, text, isLive) {
    const container = document.getElementById('novaWidgetMessages');
    if (!container) return null;

    const isUser = role === 'user';
    const wrapperDiv = document.createElement('div');
    wrapperDiv.style.display = 'flex';
    wrapperDiv.style.alignItems = 'flex-start';
    wrapperDiv.style.gap = '10px';

    if (isUser) {
      wrapperDiv.style.justifyContent = 'flex-end';
      const bubble = document.createElement('div');
      bubble.className = 'nova-widget-bubble-user';
      bubble.textContent = text;
      wrapperDiv.appendChild(bubble);
      container.appendChild(wrapperDiv);
      scrollNovaWidgetBottom();
      return bubble;
    }

    const avatar = document.createElement('div');
    avatar.style.width = '28px';
    avatar.style.height = '28px';
    avatar.style.borderRadius = '9999px';
    avatar.style.overflow = 'hidden';
    avatar.style.border = '1px solid rgba(6, 182, 212, 0.5)';
    avatar.style.padding = '1px';
    avatar.style.background = '#020617';
    avatar.style.flexShrink = '0';
    avatar.style.marginTop = '2px';
    avatar.innerHTML = '<img src="/images/nova-icon.jpg?v=20260925" alt="Nova" style="width:100%;height:100%;object-fit:cover;border-radius:9999px;">';

    const bubble = document.createElement('div');
    bubble.className = 'nova-widget-bubble-assistant' + (isLive ? ' nova-live-stream' : '');
    bubble.innerHTML = renderSimpleMarkdown(text);

    wrapperDiv.appendChild(avatar);
    wrapperDiv.appendChild(bubble);
    container.appendChild(wrapperDiv);
    scrollNovaWidgetBottom();
    return bubble;
  }

  function scrollNovaWidgetBottom() {
    const container = document.getElementById('novaWidgetMessages');
    if (container) container.scrollTop = container.scrollHeight;
  }

  window.sendNovaWidgetPrompt = function (promptText) {
    const input = document.getElementById('novaWidgetInput');
    if (!input) return;
    input.value = promptText;
    const form = document.getElementById('novaWidgetForm');
    if (form) form.dispatchEvent(new Event('submit', { cancelable: true }));
  };

  window.handleNovaWidgetSubmit = async function (event) {
    if (event) event.preventDefault();
    if (window._novaWidgetStreaming) return;

    const input = document.getElementById('novaWidgetInput');
    const sendBtn = document.getElementById('novaWidgetSendBtn');
    if (!input) return;

    const userText = input.value.trim();
    if (!userText) return;
    input.value = '';

    const chips = document.getElementById('novaWidgetQuickChips');
    if (chips) chips.style.display = 'none';

    appendNovaWidgetBubble('user', userText, false);
    window._novaWidgetMessages.push({ role: 'user', content: userText });
    saveGuestSessionHistory();

    window._novaWidgetStreaming = true;
    if (sendBtn) sendBtn.disabled = true;
    const bubbleContent = appendNovaWidgetBubble('assistant', '...', true);

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'novaAI:latest',
          persona: 'nova',
          tools: false,
          messages: window._novaWidgetMessages.slice(-10)
        })
      });

      if (!response.ok) {
        let errMessage = 'Server error (' + response.status + ')';
        try {
          const errJson = await response.json();
          if (errJson && errJson.error) errMessage = errJson.error;
        } catch (e) {}
        const err = new Error(errMessage);
        err.status = response.status;
        throw err;
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let streamedText = '';
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || !trimmed.startsWith('data:')) continue;
          const dataStr = trimmed.replace(/^data:\s*/, '');
          if (dataStr === '[DONE]') continue;
          try {
            const parsed = JSON.parse(dataStr);
            const token = (parsed.message && parsed.message.content) || parsed.response || '';
            if (token) {
              streamedText += token;
              if (bubbleContent) {
                bubbleContent.innerHTML = renderSimpleMarkdown(streamedText);
                scrollNovaWidgetBottom();
              }
            }
          } catch (e) {}
        }
      }

      if (!streamedText) {
        streamedText = "I'm right here with you! Let me know what you'd like to check out next.";
        if (bubbleContent) bubbleContent.innerHTML = renderSimpleMarkdown(streamedText);
      }

      window._novaWidgetMessages.push({ role: 'assistant', content: streamedText });
      saveGuestSessionHistory();
      checkGuestPrompt();
    } catch (err) {
      if (bubbleContent) {
        const studioHref = isAuthenticated ? '/novaai' : '/login?next=%2Fnovaai';
        bubbleContent.innerHTML =
          '<span style="color:#fbbf24;">' +
          renderSimpleMarkdown(err.message || 'Connection interrupted.') +
          ' <a href="' +
          studioHref +
          '" style="color:#22d3ee;text-decoration:underline;">Sign in to Nova &rarr;</a></span>';
      }
    } finally {
      window._novaWidgetStreaming = false;
      if (sendBtn) sendBtn.disabled = false;
      if (bubbleContent) bubbleContent.classList.remove('nova-live-stream');
      scrollNovaWidgetBottom();
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWidgetHistory);
  } else {
    initWidgetHistory();
  }
})();
</script>
