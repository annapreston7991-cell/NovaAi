<!DOCTYPE html>
<html lang="en" class="dark h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Nova AI — Executive Companion | LLYVerse</title>
  
  <meta name="theme-color" content="#020617">
  <link rel="manifest" href="/nova-manifest.json">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <script src="/js/tailwind.min.js"></script>
  <script src="/js/lucide.min.js"></script>
  
  <script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        colors: {
          brand: { 400: '#c084fc', 500: '#a855f7', 600: '#9333ea', 900: '#3b0764' },
          dark: { 800: '#1e293b', 900: '#0f172a', 950: '#080b12' }
        }
      }
    }
  };
  </script>
  <style>
  body { font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif; }
  .pulse-glow { box-shadow: 0 0 25px rgba(168, 85, 247, 0.4); }
  .glass-card { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
  .studio-grid { display: grid; grid-template-columns: 1fr; width: 100%; height: 100%; }
  @media (min-width: 1024px) {
    .studio-grid.computer-open { grid-template-columns: 1fr 1fr; }
    .thunar-row:hover { background: rgba(168, 85, 247, 0.12); }
  }
  </style>
</head>
<body class="h-full flex flex-col bg-dark-950 text-gray-100 overflow-hidden antialiased">

  <!-- Minimal Header Navigation -->
  <header class="bg-dark-900/90 backdrop-blur-xl border-b border-white/10 px-3.5 sm:px-4 py-2.5 flex items-center justify-between shrink-0 z-30">
    <!-- Brand Logo & Identity -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <a href="/nova" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-500 to-cyan-400 flex items-center justify-center text-white font-bold text-sm shadow-lg pulse-glow shrink-0">
          N
        </div>
        <div>
          <h1 class="font-bold text-xs sm:text-sm text-white tracking-tight flex items-center gap-1.5">
            <span>Nova</span>
            <% if (isOwnerAdmin) { %>
              <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">FOUNDER</span>
            <% } else { %>
              <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">ONLINE</span>
            <% } %>
          </h1>
          <p class="text-[9px] font-mono text-purple-300 hidden sm:block">Executive AI Companion</p>
        </div>
      </a>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-1.5 shrink-0 text-xs font-mono">
      <!-- Skills & Connectors Trigger (Available for Customer & Founder) -->
      <button onclick="toggleSkillsModal()" id="btn_skills" class="px-2.5 py-1.5 rounded-xl bg-purple-600/15 hover:bg-purple-600/25 border border-purple-500/30 text-purple-300 hover:text-white transition flex items-center gap-1.5 cursor-pointer" title="View Active Skills & Tools">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-purple-400"></i>
        <span class="text-xs font-semibold">Skills</span>
      </button>

      <% if (isOwnerAdmin) { %>
        <!-- Founder Exclusive: Nova Linux Computer Toggle (Default: Hidden) -->
        <button onclick="toggleComputerPane()" id="btn_computer_pane" class="px-2.5 py-1.5 rounded-xl bg-white/5 hover:bg-emerald-600/20 border border-white/10 hover:border-emerald-500/40 text-slate-300 hover:text-emerald-300 transition flex items-center gap-1.5 cursor-pointer" title="Toggle Nova Private Linux Computer">
          <i data-lucide="terminal" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Computer</span>
        </button>

        <!-- Founder Exclusive: Multi-Bot Command Center Link -->
        <a href="/command" class="px-2.5 py-1.5 rounded-xl bg-white/5 hover:bg-cyan-600/20 border border-white/10 hover:border-cyan-500/40 text-slate-300 hover:text-cyan-300 transition flex items-center gap-1.5" title="Open Multi-Bot Fleet Command Center">
          <i data-lucide="layout-grid" class="w-3.5 h-3.5 text-cyan-400"></i>
          <span class="hidden md:inline">Command</span>
        </a>
      <% } %>

      <!-- Universal Site Nav Menu -->
      <button id="novaMenuBtn" onclick="toggleUniversalNav()" title="Navigation Menu" aria-label="Open Navigation Menu" class="universal-nav-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 active:bg-white/20 text-slate-200 hover:text-white border border-white/10 transition active:scale-95 cursor-pointer shrink-0">
        <i id="novaMenuIcon" data-lucide="menu" class="w-3.5 h-3.5 text-purple-400 pointer-events-none"></i>
        <span class="text-xs font-semibold hidden sm:inline">Menu</span>
      </button>
    </div>
  </header>

  <!-- Workspace Main Grid -->
  <main id="studio_container" class="flex-1 overflow-hidden relative studio-grid">
    
    <!-- Chat Pane (Always Active) -->
    <section id="pane_chat" class="flex flex-col bg-dark-950 overflow-hidden">
      
      <!-- Status Bar -->
      <div class="px-4 py-2 bg-dark-900/60 border-b border-white/5 flex items-center justify-between text-xs font-mono text-slate-300 shrink-0">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-purple-300 font-bold">Nova AI</span>
          <span class="text-slate-400 text-[11px] hidden sm:inline">• Direct Neural Stream</span>
        </div>
        <div class="text-[10px] text-slate-400 flex items-center gap-2">
          <% if (isOwnerAdmin) { %>
            <button onclick="toggleThinkMode()" id="btn_think_mode" class="px-2 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-purple-300 flex items-center gap-1 cursor-pointer" title="Deep Reasoning Mode">
              <i data-lucide="brain" class="w-3 h-3 text-purple-400"></i>
              <span>Think</span>
            </button>
            <span id="badge_think" class="hidden px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">THINK ACTIVE</span>
          <% } %>
        </div>
      </div>

      <!-- Messages Feed -->
      <div id="nova_messages_feed" class="flex-1 overflow-y-auto p-4 space-y-4 text-xs sm:text-sm font-sans scrollbar-thin">
        <div class="flex gap-3 items-start">
          <div class="w-8 h-8 rounded-xl bg-purple-600/30 border border-purple-500/40 text-purple-300 flex items-center justify-center shrink-0 font-bold shadow-md">N</div>
          <div class="glass-card p-4 rounded-2xl max-w-[88%] text-slate-100 leading-relaxed space-y-2">
            <div class="font-bold text-purple-300 text-xs flex items-center justify-between border-b border-white/10 pb-1">
              <span>Nova (Executive AI Companion)</span>
              <span class="text-[10px] font-mono text-emerald-400">LLYVerse Neural Core</span>
            </div>
            <div>
              <% if (isOwnerAdmin) { %>
                Welcome back, Founder!
                <br><br>
                I am ready to assist with system operations, architecture, research, or workspace coding.
                <br><br>
                <span class="text-xs text-purple-300 font-mono">💡 Tip: Tap <strong>Computer</strong> in the top bar whenever you wish to open my private Linux workstation (Thunar, Terminal, Code Editor, and Servers).</span>
              <% } else { %>
                Welcome to LLYVerse! I am Nova, your executive AI companion.
                <br><br>
                I am equipped with live web research, ecosystem knowledge, and creative tools to help you explore music, creative works, and technology across the LLYVerse. What can we dive into today?
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Clean Starter Chips -->
      <div class="px-3 py-2 bg-dark-900/60 border-t border-white/5 flex items-center gap-2 overflow-x-auto scrollbar-thin text-xs font-mono shrink-0">
        <% if (isOwnerAdmin) { %>
          <button onclick="sendQuickPrompt('Show live LLYVerse telemetry and node stats')" class="px-2.5 py-1 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 font-semibold transition shrink-0">
            📊 System Telemetry
          </button>
          <button onclick="sendQuickPrompt('Search web for latest AI research and updates')" class="px-2.5 py-1 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 transition shrink-0">
            🔎 Web Research
          </button>
          <button onclick="sendQuickPrompt('Check Monero wallet sync and Flame status')" class="px-2.5 py-1 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 transition shrink-0">
            ⛓️ Treasury &amp; Staking
          </button>
          <button onclick="toggleComputerPane()" class="px-2.5 py-1 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 font-semibold transition shrink-0">
            💻 Open Linux Station
          </button>
        <% } else { %>
          <button onclick="sendQuickPrompt('What is LLYVerse and what can I do here?')" class="px-2.5 py-1 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 font-semibold transition shrink-0">
            ✨ Explore LLYVerse
          </button>
          <button onclick="sendQuickPrompt('Tell me about AuraStream and creative audio in LLYVerse')" class="px-2.5 py-1 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 transition shrink-0">
            🎵 AuraStream Music
          </button>
          <button onclick="sendQuickPrompt('What skills and tools do you have active?')" class="px-2.5 py-1 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 transition shrink-0">
            ⚡ Nova Skills &amp; Tools
          </button>
          <button onclick="sendQuickPrompt('Search the latest updates across the ecosystem')" class="px-2.5 py-1 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 transition shrink-0">
            🔎 Search Ecosystem
          </button>
        <% } %>
      </div>

      <!-- Input Bar -->
      <div class="p-3 bg-dark-900 border-t border-white/10 flex items-center gap-2 shrink-0">
        <button onclick="startVoiceInput()" id="btn_mic" title="Voice Input" class="p-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 text-purple-300 transition cursor-pointer shrink-0">
          <i data-lucide="mic" class="w-4 h-4"></i>
        </button>

        <input type="text" id="nova_input" placeholder="Message Nova or ask a question..." 
          class="flex-1 px-4 py-3 rounded-2xl bg-dark-950 border border-white/10 text-xs sm:text-sm text-white focus:outline-none focus:border-purple-500 transition"
          onkeydown="if(event.key==='Enter') submitNovaPrompt()">

        <button onclick="submitNovaPrompt()" class="px-4 sm:px-5 py-3 rounded-2xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition flex items-center gap-1.5 shadow-lg shadow-purple-600/30 cursor-pointer shrink-0">
          <span>Send</span>
          <i data-lucide="send" class="w-3.5 h-3.5"></i>
        </button>
      </div>
    </section>

    <% if (isOwnerAdmin) { %>
<!-- Right Pane: Nova Personal Linux Computer & Thunar Workstation -->
 <section id="pane_computer" class="hidden flex flex-col bg-dark-900/90 overflow-hidden border-l border-white/10">
 
 <!-- Computer Control Window Bar (Linux Desktop Header) -->
 <div class="px-4 py-2 bg-dark-950 border-b border-white/10 flex items-center justify-between text-xs font-mono shrink-0">
 <div class="flex items-center gap-2">
 <div class="flex items-center gap-1.5 mr-1">
 <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
 <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
 <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
 </div>
 <i data-lucide="monitor" class="w-4 h-4 text-emerald-400"></i>
 <span class="font-bold text-white">nova@linux-station</span>
 <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold hidden sm:inline">THUNAR SYSTEM</span>
 </div>

 <!-- Station Navigation Tabs: Thunar, Code Studio, Terminal, Server Runner -->
 <div class="flex items-center gap-1.5">
 <button onclick="switchComputerTab('thunar')" id="tab_comp_thunar" class="px-2.5 py-1 rounded-lg bg-emerald-600/30 text-emerald-300 font-bold border border-emerald-500/40 flex items-center gap-1 cursor-pointer transition">
 <i data-lucide="folder" class="w-3.5 h-3.5"></i>
 <span>Thunar</span>
 </button>
 <button onclick="switchComputerTab('editor')" id="tab_comp_editor" class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 hover:text-white border border-white/10 flex items-center gap-1 cursor-pointer transition">
 <i data-lucide="code-2" class="w-3.5 h-3.5"></i>
 <span>Editor</span>
 </button>
 <button onclick="switchComputerTab('terminal')" id="tab_comp_terminal" class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 hover:text-white border border-white/10 flex items-center gap-1 cursor-pointer transition">
 <i data-lucide="terminal" class="w-3.5 h-3.5"></i>
 <span>Terminal</span>
 </button>
 <button onclick="switchComputerTab('server')" id="tab_comp_server" class="px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 hover:text-white border border-white/10 flex items-center gap-1 cursor-pointer transition">
 <i data-lucide="server" class="w-3.5 h-3.5"></i>
 <span>Server</span>
 </button>
 </div>
 </div>

 <!-- Active Viewport Container -->
 <div class="flex-1 overflow-hidden relative flex flex-col bg-slate-950/90">

 <!-- TAB 1: THUNAR FILE MANAGER -->
 <div id="view_comp_thunar" class="flex-1 flex flex-col overflow-hidden">
 <!-- Thunar Toolbar & Path Breadcrumbs -->
 <div class="px-3 py-1.5 bg-dark-900 border-b border-white/10 flex items-center justify-between text-xs font-mono">
 <div class="flex items-center gap-1 text-slate-300 overflow-x-auto scrollbar-thin">
 <button onclick="loadThunarDirectory('')" class="p-1 hover:text-white rounded hover:bg-white/5 cursor-pointer" title="Go to Root Workspace">
 <i data-lucide="home" class="w-3.5 h-3.5 text-emerald-400"></i>
 </button>
 <span>/</span>
 <span id="thunar_current_path_crumb" class="text-emerald-300 font-bold">workspace</span>
 </div>
 <div class="flex items-center gap-1.5 shrink-0">
 <button onclick="promptCreateFolder()" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-[11px] flex items-center gap-1 cursor-pointer">
 <i data-lucide="folder-plus" class="w-3 h-3 text-cyan-400"></i>
 <span class="hidden sm:inline">New Folder</span>
 </button>
 <button onclick="promptCreateFile()" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-[11px] flex items-center gap-1 cursor-pointer">
 <i data-lucide="file-plus" class="w-3 h-3 text-emerald-400"></i>
 <span class="hidden sm:inline">New File</span>
 </button>
 <button onclick="loadThunarDirectory(currentThunarPath)" class="p-1 hover:text-white rounded hover:bg-white/5 text-slate-400 cursor-pointer" title="Refresh Thunar">
 <i data-lucide="refresh-cw" class="w-3 h-3"></i>
 </button>
 </div>
 </div>

 <!-- Thunar File & Folder Explorer Table -->
 <div class="flex-1 overflow-y-auto p-2 scrollbar-thin">
 <table class="w-full text-left text-xs font-mono text-slate-300">
 <thead>
 <tr class="text-[11px] text-slate-400 border-b border-white/5 pb-1">
 <th class="py-1.5 px-3">Name</th>
 <th class="py-1.5 px-2 hidden sm:table-cell">Size</th>
 <th class="py-1.5 px-2 hidden md:table-cell">Modified</th>
 <th class="py-1.5 px-2 text-right">Action</th>
 </tr>
 </thead>
 <tbody id="thunar_file_list" class="divide-y divide-white/5">
 <!-- Loaded via JavaScript -->
 </tbody>
 </table>
 </div>

 <!-- Thunar Status Bar -->
 <div class="px-3 py-1 bg-dark-900/90 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400">
 <span id="thunar_status_count">Loading items...</span>
 <span class="text-emerald-400 flex items-center gap-1">
 <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
 Linux ext4 partition
 </span>
 </div>
 </div>

 <!-- TAB 2: CODE STUDIO EDITOR -->
 <div id="view_comp_editor" class="flex-1 flex flex-col overflow-hidden hidden">
 <!-- Editor Control Bar -->
 <div class="px-3 py-1.5 bg-dark-900 border-b border-white/10 flex items-center justify-between text-xs font-mono">
 <div class="flex items-center gap-2">
 <i data-lucide="file-code" class="w-3.5 h-3.5 text-purple-400"></i>
 <span id="editor_file_path" class="font-bold text-white">server.js</span>
 <span id="editor_dirty_indicator" class="hidden text-[10px] text-amber-400 font-bold">• UNSAVED</span>
 </div>
 <div class="flex items-center gap-2">
 <button onclick="saveEditorFile()" class="px-3 py-1 rounded bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 font-bold border border-emerald-500/40 text-[11px] flex items-center gap-1 cursor-pointer transition">
 <i data-lucide="save" class="w-3 h-3"></i>
 <span>Save File</span>
 </button>
 <button onclick="runCodeInTerminal()" class="px-3 py-1 rounded bg-purple-600/30 hover:bg-purple-600/50 text-purple-300 font-bold border border-purple-500/40 text-[11px] flex items-center gap-1 cursor-pointer transition">
 <i data-lucide="play" class="w-3 h-3"></i>
 <span>Execute Code</span>
 </button>
 </div>
 </div>

 <!-- Editor Textarea Area -->
 <div class="flex-1 p-2 bg-dark-950 overflow-hidden relative flex flex-col">
 <textarea id="code_editor_textarea" oninput="markEditorDirty()" spellcheck="false"
 class="flex-1 w-full p-4 rounded-xl bg-dark-900 border border-white/10 font-mono text-xs text-purple-200 leading-relaxed focus:outline-none focus:border-purple-500/60 scrollbar-thin resize-none">
// Select a file in Thunar to edit code...
 </textarea>
 </div>
 </div>

 <!-- TAB 3: BASH TERMINAL EMULATOR -->
 <div id="view_comp_terminal" class="flex-1 flex flex-col overflow-hidden hidden">
 <!-- Terminal Header -->
 <div class="px-3 py-1.5 bg-dark-900 border-b border-white/10 flex items-center justify-between text-xs font-mono">
 <div class="flex items-center gap-2 text-slate-300">
 <i data-lucide="terminal" class="w-3.5 h-3.5 text-emerald-400"></i>
 <span class="text-white font-bold">Bash Terminal</span>
 <span class="text-[10px] text-slate-400 font-mono">(/bin/bash)</span>
 </div>
 <div class="flex items-center gap-2">
 <button onclick="clearTerminalScreen()" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white text-[11px] cursor-pointer">
 Clear
 </button>
 </div>
 </div>

 <!-- Terminal Output Stream -->
 <div id="terminal_output_log" class="flex-1 p-3 bg-black/90 font-mono text-xs text-emerald-400 overflow-y-auto scrollbar-thin space-y-1.5">
 <div class="text-slate-400">Nova Linux Computer Station [Version 2.0.0]</div>
 <div class="text-slate-400">Workspace mounted at /home/lily/nova-computer/workspace</div>
 <div class="text-cyan-400 font-bold">Type any bash command below to execute directly in Nova's environment.</div>
 </div>

 <!-- Terminal Command Input Bar -->
 <div class="p-2 bg-dark-900 border-t border-white/10 flex items-center gap-2 font-mono text-xs">
 <span class="text-emerald-400 font-bold shrink-0">nova@station:~$</span>
 <input type="text" id="terminal_cmd_input" placeholder="e.g. ls -la, node -v, npm test, cat server.js..."
 class="flex-1 bg-transparent border-0 text-white focus:outline-none text-xs font-mono"
 onkeydown="if(event.key==='Enter') executeTerminalCommand()">
 <button onclick="executeTerminalCommand()" class="px-3 py-1 rounded bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 font-bold border border-emerald-500/40 text-[11px] cursor-pointer">
 Run
 </button>
 </div>
 </div>

 <!-- TAB 4: AUTONOMOUS SERVER RUNNER & MONITOR -->
 <div id="view_comp_server" class="flex-1 flex flex-col overflow-hidden p-4 space-y-4 overflow-y-auto scrollbar-thin hidden">
 <div class="glass-card p-4 rounded-2xl border border-white/10 space-y-3">
 <div class="flex items-center justify-between border-b border-white/10 pb-2">
 <h3 class="text-sm font-bold text-white flex items-center gap-2">
 <i data-lucide="server" class="w-4 h-4 text-cyan-400"></i>
 <span>Nova Autonomous Server Control</span>
 </h3>
 <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold">
 DAEMON RUNNER
 </span>
 </div>

 <p class="text-xs text-slate-300 leading-relaxed">
 Nova can code her own microservices, web servers, and API backends, then spin them up autonomously on private ports.
 </p>

 <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs">
 <div class="p-2.5 rounded-xl bg-dark-950 border border-white/10 space-y-1">
 <div class="text-[10px] text-slate-400">ENTRYPOINT</div>
 <div class="font-bold text-white text-xs">server.js</div>
 </div>
 <div class="p-2.5 rounded-xl bg-dark-950 border border-white/10 space-y-1">
 <div class="text-[10px] text-slate-400">PORT</div>
 <div class="font-bold text-emerald-400 text-xs">4200</div>
 </div>
 <div class="p-2.5 rounded-xl bg-dark-950 border border-white/10 space-y-1">
 <div class="text-[10px] text-slate-400">SERVICE URL</div>
 <div class="font-bold text-cyan-300 text-xs">http://localhost:4200</div>
 </div>
 </div>

 <div class="flex items-center gap-2 pt-2">
 <button onclick="startNovaServer()" class="px-4 py-2 rounded-xl bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 font-bold border border-emerald-500/40 text-xs flex items-center gap-1.5 cursor-pointer transition">
 <i data-lucide="play" class="w-3.5 h-3.5"></i>
 <span>Start Nova Server (Port 4200)</span>
 </button>
 <button onclick="stopNovaServer()" class="px-4 py-2 rounded-xl bg-rose-600/30 hover:bg-rose-600/50 text-rose-300 font-bold border border-rose-500/40 text-xs flex items-center gap-1.5 cursor-pointer transition">
 <i data-lucide="square" class="w-3.5 h-3.5"></i>
 <span>Stop Server</span>
 </button>
 <button onclick="pingNovaServer()" class="px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-200 border border-white/10 text-xs flex items-center gap-1.5 cursor-pointer transition">
 <i data-lucide="activity" class="w-3.5 h-3.5 text-cyan-400"></i>
 <span>Test Ping</span>
 </button>
 </div>
 </div>

 <!-- Active Server Telemetry Box -->
