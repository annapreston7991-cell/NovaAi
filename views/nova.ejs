  <script>
  lucide.createIcons();

  const isOwnerAdmin = <%= isOwnerAdmin ? 'true' : 'false' %>;
  let isThinkMode = false;
  let isComputerOpen = false; // DEFAULT SET TO HIDE FOR FOUNDER
  let currentCompTab = 'thunar';
  let currentThunarPath = '';
  let activeEditorPath = 'server.js';
  let isEditorDirty = false;

  function toggleSkillsModal() {
    const modal = document.getElementById('skills_modal');
    if (modal) modal.classList.toggle('hidden');
    lucide.createIcons();
  }

  function toggleThinkMode() {
    isThinkMode = !isThinkMode;
    const btn = document.getElementById('btn_think_mode');
    const badge = document.getElementById('badge_think');
    if (btn) {
      if (isThinkMode) {
        btn.classList.add('bg-purple-600/30', 'text-purple-300', 'border-purple-500/40', 'font-bold');
        if (badge) badge.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-purple-600/30', 'text-purple-300', 'border-purple-500/40', 'font-bold');
        if (badge) badge.classList.add('hidden');
      }
    }
  }

  function toggleComputerPane() {
    if (!isOwnerAdmin) return;
    isComputerOpen = !isComputerOpen;
    const grid = document.getElementById('studio_container');
    const paneComp = document.getElementById('pane_computer');
    const btn = document.getElementById('btn_computer_pane');

    if (paneComp && grid) {
      if (isComputerOpen) {
        grid.classList.add('computer-open');
        paneComp.classList.remove('hidden');
        if (btn) {
          btn.classList.add('bg-emerald-600/30', 'text-emerald-300', 'border-emerald-500/40', 'font-bold');
          btn.classList.remove('text-slate-300', 'bg-white/5');
        }
        if (!currentThunarPath) {
          loadThunarDirectory('');
          loadEditorFile('server.js');
        }
      } else {
        grid.classList.remove('computer-open');
        paneComp.classList.add('hidden');
        if (btn) {
          btn.classList.remove('bg-emerald-600/30', 'text-emerald-300', 'border-emerald-500/40', 'font-bold');
          btn.classList.add('text-slate-300', 'bg-white/5');
        }
      }
    }
    lucide.createIcons();
  }

  function switchComputerTab(tab) {
    currentCompTab = tab;
    const tabs = ['thunar', 'editor', 'terminal', 'server'];
    tabs.forEach(t => {
      const v = document.getElementById('view_comp_' + t);
      const btn = document.getElementById('tab_comp_' + t);
      if (v) v.classList.toggle('hidden', t !== tab);
      if (btn) {
        if (t === tab) {
          btn.className = 'px-2.5 py-1 rounded-lg bg-emerald-600/30 text-emerald-300 font-bold border border-emerald-500/40 flex items-center gap-1 cursor-pointer transition';
        } else {
          btn.className = 'px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 hover:text-white border border-white/10 flex items-center gap-1 cursor-pointer transition';
        }
      }
    });

    if (tab === 'thunar') loadThunarDirectory(currentThunarPath);
    if (tab === 'server') refreshServerStatus();
    lucide.createIcons();
  }

  // --- THUNAR FILE MANAGER FUNCTIONS ---
  async function loadThunarDirectory(relPath = '') {
    if (!isOwnerAdmin) return;
    currentThunarPath = relPath;
    const tbody = document.getElementById('thunar_file_list');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="4" class="py-4 text-center text-slate-400">Loading directory...</td></tr>';
    const crumb = document.getElementById('thunar_current_path_crumb');
    if (crumb) crumb.innerText = relPath ? 'workspace/' + relPath : 'workspace';

    try {
      const res = await fetch('/api/nova/computer/files?path=' + encodeURIComponent(relPath));
      const data = await res.json();
      if (!data.success) {
        tbody.innerHTML = '<tr><td colspan="4" class="py-4 text-center text-rose-400">' + (data.error || 'Error loading files') + '</td></tr>';
        return;
      }

      let htmlRows = "";
      if (relPath) {
        const parentParts = relPath.split("/").slice(0, -1);
        const parentPath = parentParts.join("/");
        htmlRows += `<tr class="thunar-row cursor-pointer transition group" onclick="loadThunarDirectory('${parentPath}')">
          <td class="py-2 px-3 flex items-center gap-2 text-slate-400 group-hover:text-white">
          <i data-lucide="corner-left-up" class="w-3.5 h-3.5 text-slate-400"></i>
          <span>.. (Parent Directory)</span></td>
          <td class="py-2 px-2 text-slate-400 hidden sm:table-cell">-</td>
          <td class="py-2 px-2 text-slate-400 hidden md:table-cell">-</td>
          <td class="py-2 px-2 text-right"></td></tr>`;
      }

      data.items.forEach(item => {
        const iconName = item.isDirectory ? "folder" : (item.name.endsWith(".js") ? "file-code" : (item.name.endsWith(".json") ? "file-json" : "file-text"));
        const iconColor = item.isDirectory ? "text-cyan-400" : "text-purple-400";
        const clickHandler = item.isDirectory 
          ? `loadThunarDirectory('${item.path}')` 
          : `openFileInEditor('${item.path}')`;
        const sizeFormatted = item.size !== null ? (item.size > 1024 ? (item.size/1024).toFixed(1) + " KB" : item.size + " B") : "Folder";
        const dateFormatted = item.mtime ? new Date(item.mtime).toLocaleDateString() : "-";

        htmlRows += `<tr class="thunar-row transition group">
          <td class="py-2 px-3 cursor-pointer flex items-center gap-2 group-hover:text-emerald-300 font-medium" onclick="${clickHandler}">
          <i data-lucide="${iconName}" class="w-3.5 h-3.5 ${iconColor} shrink-0"></i>
          <span>${escapeHtml(item.name)}</span></td>
          <td class="py-2 px-2 text-slate-400 text-[11px] hidden sm:table-cell">${sizeFormatted}</td>
          <td class="py-2 px-2 text-slate-400 text-[11px] hidden md:table-cell">${dateFormatted}</td>
          <td class="py-2 px-2 text-right">
          <div class="flex items-center justify-end gap-1">
          ${!item.isDirectory ? `<button onclick="openFileInEditor('${item.path}')" class="p-1 text-slate-400 hover:text-white rounded hover:bg-white/5" title="Edit Code"><i data-lucide="edit-3" class="w-3 h-3 text-purple-400"></i></button>` : ""}
          <button onclick="deleteThunarItem('${item.path}', '${escapeHtml(item.name)}')" class="p-1 text-slate-400 hover:text-rose-400 rounded hover:bg-white/5" title="Delete"><i data-lucide="trash-2" class="w-3 h-3"></i></button>
          </div></td></tr>`;
      });
      tbody.innerHTML = htmlRows || '<tr><td colspan="4" class="py-4 text-center text-slate-400">Empty folder</td></tr>';
      const statusCount = document.getElementById('thunar_status_count');
      if (statusCount) statusCount.innerText = data.items.length + ' items in /' + relPath;
      lucide.createIcons();
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="4" class="py-4 text-center text-rose-400">Error: ' + err.message + '</td></tr>';
    }
  }

  async function promptCreateFolder() {
    const name = prompt('Enter new folder name:');
    if (!name || !name.trim()) return;
    const targetPath = currentThunarPath ? currentThunarPath + '/' + name.trim() : name.trim();
    try {
      const res = await fetch('/api/nova/computer/folder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: targetPath })
      });
      const data = await res.json();
      if (data.success) {
        loadThunarDirectory(currentThunarPath);
      } else {
        alert('Failed: ' + data.error);
      }
    } catch (e) { alert(e.message); }
  }

  async function promptCreateFile() {
    const name = prompt('Enter new file name:');
    if (!name || !name.trim()) return;
    const targetPath = currentThunarPath ? currentThunarPath + '/' + name.trim() : name.trim();
    try {
      const res = await fetch('/api/nova/computer/file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: targetPath, content: '// New microservice script\n' })
      });
      const data = await res.json();
      if (data.success) {
        loadThunarDirectory(currentThunarPath);
        openFileInEditor(targetPath);
      } else {
        alert('Failed: ' + data.error);
      }
    } catch (e) { alert(e.message); }
  }

  async function deleteThunarItem(relPath, name) {
    if (!confirm('Are you sure you want to delete ' + name + '?')) return;
    try {
      const res = await fetch('/api/nova/computer/file?path=' + encodeURIComponent(relPath), { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        loadThunarDirectory(currentThunarPath);
      } else {
        alert('Failed: ' + data.error);
      }
    } catch (e) { alert(e.message); }
  }

  // --- CODE EDITOR FUNCTIONS ---
  function openFileInEditor(filePath) {
    switchComputerTab('editor');
    loadEditorFile(filePath);
  }

  async function loadEditorFile(filePath) {
    if (!isOwnerAdmin) return;
    activeEditorPath = filePath;
    const statusElem = document.getElementById('editor_active_file');
    if (statusElem) statusElem.innerText = filePath;
    const editor = document.getElementById('code_editor_textarea');
    if (editor) editor.value = '// Loading file content...';

    try {
      const res = await fetch('/api/nova/computer/file?path=' + encodeURIComponent(filePath));
      const data = await res.json();
      if (data.success && editor) {
        editor.value = data.content;
        updateLineNumbers();
        isEditorDirty = false;
        const dirtyBadge = document.getElementById('editor_dirty_indicator');
        if (dirtyBadge) dirtyBadge.classList.add('hidden');
      } else if (editor) {
        editor.value = '// Error loading file: ' + (data.error || 'Unknown');
      }
    } catch (err) {
      if (editor) editor.value = '// Error: ' + err.message;
    }
  }

  function updateLineNumbers() {
    const editor = document.getElementById('code_editor_textarea');
    const lineBox = document.getElementById('code_editor_lines');
    if (!editor || !lineBox) return;
    const lineCount = editor.value.split('\n').length;
    let linesHtml = '';
    for (let i = 1; i <= Math.max(lineCount, 15); i++) {
      linesHtml += i + '<br>';
    }
    lineBox.innerHTML = linesHtml;
  }

  async function saveCurrentEditorFile() {
    const editor = document.getElementById('code_editor_textarea');
    if (!editor) return;
    const content = editor.value;
    try {
      const res = await fetch('/api/nova/computer/file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: activeEditorPath, content })
      });
      const data = await res.json();
      if (data.success) {
        isEditorDirty = false;
        const dirtyBadge = document.getElementById('editor_dirty_indicator');
        if (dirtyBadge) dirtyBadge.classList.add('hidden');
        alert('File ' + activeEditorPath + ' saved successfully!');
      } else {
        alert('Failed to save: ' + data.error);
      }
    } catch (err) {
      alert('Error saving: ' + err.message);
    }
  }

  // --- TERMINAL FUNCTIONS ---
  async function executeBashTerminal() {
    const input = document.getElementById('terminal_command_input');
    const cmd = input.value.trim();
    if (!cmd) return;

    const outBox = document.getElementById('terminal_output_box');
    outBox.innerHTML += `<div class="text-cyan-300">$ ${escapeHtml(cmd)}</div>`;
    input.value = '';

    try {
      const res = await fetch('/api/nova/computer/terminal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: cmd, cwd: currentThunarPath || '' })
      });
      const data = await res.json();
      if (data.stdout) outBox.innerHTML += `<div class="text-slate-200 whitespace-pre-wrap">${escapeHtml(data.stdout)}</div>`;
      if (data.stderr) outBox.innerHTML += `<div class="text-rose-400 whitespace-pre-wrap">${escapeHtml(data.stderr)}</div>`;
      if (!data.stdout && !data.stderr) outBox.innerHTML += `<div class="text-slate-500 italic">[Process exited with code ${data.exitCode}]</div>`;
    } catch (err) {
      outBox.innerHTML += `<div class="text-rose-400">Error: ${escapeHtml(err.message)}</div>`;
    }
    outBox.scrollTop = outBox.scrollHeight;
  }

  function clearTerminalOutput() {
    const outBox = document.getElementById('terminal_output_box');
    if (outBox) outBox.innerHTML = '<div class="text-slate-500">Terminal buffer cleared.</div>';
  }

  // --- SERVER RUNNER FUNCTIONS ---
  async function startMicroserviceServer() {
    const id = document.getElementById('server_id_input').value.trim() || 'nova-server';
    const cmd = document.getElementById('server_cmd_input').value.trim() || 'node server.js';
    const port = document.getElementById('server_port_input').value.trim() || 4200;

    try {
      const res = await fetch('/api/nova/computer/servers/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serverId: id, command: cmd, port })
      });
      const data = await res.json();
      if (data.success) {
        document.getElementById('server_runner_output').innerText = 'Server launched successfully! PID: ' + data.server.pid + ', Port: ' + data.server.port;
        document.getElementById('server_ping_badge').innerText = 'ONLINE';
        document.getElementById('server_ping_badge').className = 'text-[10px] font-mono text-emerald-400 font-bold';
      } else {
        document.getElementById('server_runner_output').innerText = 'Failed: ' + data.error;
      }
    } catch (err) {
      document.getElementById('server_runner_output').innerText = 'Error: ' + err.message;
    }
  }

  async function stopMicroserviceServer() {
    const id = document.getElementById('server_id_input').value.trim() || 'nova-server';
    try {
      const res = await fetch('/api/nova/computer/servers/stop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serverId: id })
      });
      const data = await res.json();
      document.getElementById('server_runner_output').innerText = data.success ? 'Server stopped.' : 'Failed: ' + data.error;
      document.getElementById('server_ping_badge').innerText = 'STOPPED';
      document.getElementById('server_ping_badge').className = 'text-[10px] font-mono text-slate-500';
    } catch (err) {
      document.getElementById('server_runner_output').innerText = 'Error: ' + err.message;
    }
  }

  async function pingMicroserviceServer() {
    const outBox = document.getElementById('server_runner_output');
    outBox.innerText = 'Pinging microservice on port 4200...';
    try {
      const pingRes = await fetch('/api/nova/computer/terminal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: 'curl -s http://localhost:4200 || echo "SERVER_OFFLINE"' })
      });
      const data = await pingRes.json();
      outBox.innerText = '[PING RESPONSE]:\n' + (data.stdout || data.stderr);
    } catch (err) {
      outBox.innerText = '[PING FAILED]: ' + err.message;
    }
  }

  async function refreshServerStatus() {
    if (!isOwnerAdmin) return;
    try {
      const res = await fetch('/api/nova/computer/servers');
      const data = await res.json();
      if (data.servers && data.servers.length > 0) {
        const badge = document.getElementById('server_ping_badge');
        if (badge) {
          badge.innerText = 'RUNNING';
          badge.className = 'text-[10px] font-mono text-emerald-400 font-bold';
        }
      }
    } catch (e) {}
  }

  function sendQuickPrompt(promptText) {
    document.getElementById('nova_input').value = promptText;
    submitNovaPrompt();
  }

  async function submitNovaPrompt() {
    const input = document.getElementById('nova_input');
    const text = input.value.trim();
    if (!text) return;

    const feed = document.getElementById('nova_messages_feed');
    feed.innerHTML += `
      <div class="flex gap-3 items-start justify-end">
        <div class="bg-purple-600 text-white p-3.5 rounded-2xl max-w-[85%] leading-relaxed shadow-md">
          ${escapeHtml(text)}
        </div>
      </div>
    `;
    input.value = '';
    feed.scrollTop = feed.scrollHeight;

    // Loading bubble
    const loadingId = 'loading_' + Date.now();
    feed.innerHTML += `
      <div id="${loadingId}" class="flex gap-3 items-start">
        <div class="w-8 h-8 rounded-xl bg-purple-600/30 border border-purple-500/40 text-purple-300 flex items-center justify-center shrink-0 font-bold shadow-md">N</div>
        <div class="glass-card p-4 rounded-2xl max-w-[88%] text-slate-100 leading-relaxed flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
          <span class="text-xs font-mono text-purple-300">Nova is typing...</span>
        </div>
      </div>
    `;
    feed.scrollTop = feed.scrollHeight;

    try {
      if (isOwnerAdmin) {
        // Founder executive chat with MCP tool support
        const res = await fetch('/api/nova/mcp/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, botId: 'nova', thinkMode: isThinkMode, multiAgent: false })
        });
        const data = await res.json();
        const loadElem = document.getElementById(loadingId);
        if (loadElem) loadElem.remove();

        let toolBadge = '';
        if (data.tool_executed) {
          toolBadge = `<div class="p-2 rounded-lg bg-purple-950/60 border border-purple-500/40 text-[10px] font-mono text-purple-300 mb-2 flex items-center justify-between">
            <span>⚡ Tool Executed: ${data.tool_executed.tool}</span>
            <span>${data.tool_executed.executionTimeMs}ms</span>
          </div>`;
        }

        feed.innerHTML += `
          <div class="flex gap-3 items-start">
            <div class="w-8 h-8 rounded-xl bg-purple-600/30 border border-purple-500/40 text-purple-300 flex items-center justify-center shrink-0 font-bold shadow-md">N</div>
            <div class="glass-card p-4 rounded-2xl max-w-[88%] text-slate-100 leading-relaxed space-y-2">
              <div class="font-bold text-purple-300 text-xs flex items-center justify-between border-b border-white/10 pb-1">
                <span>Nova AI</span>
                <span class="text-[10px] font-mono text-emerald-400">Executive Partner</span>
              </div>
              ${toolBadge}
              <div class="whitespace-pre-wrap">${data.response ? escapeHtml(data.response) : 'No response'}</div>
            </div>
          </div>
        `;
        feed.scrollTop = feed.scrollHeight;

        if (data.response && isComputerOpen) {
          loadThunarDirectory(currentThunarPath);
        }
      } else {
        // Customer / visitor chat with live token streaming
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [{ role: 'user', content: text }]
          })
        });

        const loadElem = document.getElementById(loadingId);
        if (loadElem) loadElem.remove();

        const msgElemId = 'msg_' + Date.now();
        feed.innerHTML += `
          <div class="flex gap-3 items-start">
            <div class="w-8 h-8 rounded-xl bg-purple-600/30 border border-purple-500/40 text-purple-300 flex items-center justify-center shrink-0 font-bold shadow-md">N</div>
            <div class="glass-card p-4 rounded-2xl max-w-[88%] text-slate-100 leading-relaxed space-y-2">
              <div class="font-bold text-purple-300 text-xs flex items-center justify-between border-b border-white/10 pb-1">
                <span>Nova AI</span>
                <span class="text-[10px] font-mono text-emerald-400">LLYVerse Neural Core</span>
              </div>
              <div id="${msgElemId}" class="whitespace-pre-wrap"></div>
            </div>
          </div>
        `;
        feed.scrollTop = feed.scrollHeight;
        const targetDiv = document.getElementById(msgElemId);

        const contentType = res.headers.get('content-type') || '';
        if (contentType.includes('text/event-stream')) {
          const reader = res.body.getReader();
          const decoder = new TextDecoder('utf-8');
          let accumulated = '';
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            const chunk = decoder.decode(value, { stream: true });
            const chunkLines = chunk.split('\n');
            for (const line of chunkLines) {
              if (line.startsWith('data: ')) {
                const dataStr = line.slice(6).trim();
                if (dataStr === '[DONE]') break;
                try {
                  const parsed = JSON.parse(dataStr);
                  if (parsed.response) {
                    accumulated += parsed.response;
                    targetDiv.innerText = accumulated;
                    feed.scrollTop = feed.scrollHeight;
                  } else if (parsed.message && parsed.message.content) {
                    accumulated += parsed.message.content;
                    targetDiv.innerText = accumulated;
                    feed.scrollTop = feed.scrollHeight;
                  }
                } catch (e) {
                  if (dataStr) {
                    accumulated += dataStr;
                    targetDiv.innerText = accumulated;
                    feed.scrollTop = feed.scrollHeight;
                  }
                }
              }
            }
          }
          if (!accumulated) targetDiv.innerText = 'I am here to help! What would you like to explore?';
        } else {
          const data = await res.json();
          targetDiv.innerText = data.response || (data.message && data.message.content) || 'I am here to help! What would you like to explore?';
        }
        feed.scrollTop = feed.scrollHeight;
      }
    } catch (err) {
      const loadElem = document.getElementById(loadingId);
      if (loadElem) loadElem.remove();
      feed.innerHTML += `<div class="p-3 text-rose-400 text-xs font-mono">Error: ${escapeHtml(err.message)}</div>`;
      feed.scrollTop = feed.scrollHeight;
    }
  }

  function selectMcpConnector(serverKey) {
    const sel = document.getElementById('mcp_type');
    if (sel) sel.value = serverKey;
    const passInput = document.getElementById('mcp_password');
    if (passInput) passInput.focus();
  }

  async function saveMcpCredentials() {
    const type = document.getElementById('mcp_type').value;
    const email = document.getElementById('mcp_email').value;
    const password = document.getElementById('mcp_password').value;

    try {
      const res = await fetch('/api/nova/mcp/credentials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serverType: type, type, email, password, token: password, apiKey: password })
      });
      const data = await res.json();
      if (data.success) {
        alert(`Successfully saved credentials for ${type.toUpperCase()}!`);
        toggleSkillsModal();
      } else {
        alert('Failed: ' + data.error);
      }
    } catch (err) {
      alert('Network error: ' + err.message);
    }
  }

  function startVoiceInput() {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
      alert('Speech Recognition is not supported in this browser. Please use Chrome, Edge, or Safari.');
      return;
    }
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.lang = 'en-US';

    const btn = document.getElementById('btn_mic');
    btn.classList.add('bg-rose-600', 'text-white', 'animate-pulse');

    recognition.onresult = (event) => {
      const transcript = event.results[0][0].transcript;
      document.getElementById('nova_input').value = transcript;
      btn.classList.remove('bg-rose-600', 'text-white', 'animate-pulse');
      submitNovaPrompt();
    };
    recognition.onerror = () => {
      btn.classList.remove('bg-rose-600', 'text-white', 'animate-pulse');
    };
    recognition.onend = () => {
      btn.classList.remove('bg-rose-600', 'text-white', 'animate-pulse');
    };
    recognition.start();
  }

  function escapeHtml(str) {
    return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    // Auto-claim guest chat token if present (WO6-25)
    (function () {
      const claimToken = new URLSearchParams(window.location.search).get('claim_token') || sessionStorage.getItem('nova_guest_claim_token');
      if (claimToken) {
        fetch('/api/nova/claim-guest-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: claimToken })
        }).then(r => r.json()).then(data => {
          if (data.success) {
            sessionStorage.removeItem('nova_guest_claim_token');
            if (window.history.replaceState) {
              const url = new URL(window.location);
              url.searchParams.delete('claim_token');
              window.history.replaceState({}, '', url);
            }
          }
        }).catch(() => {});
      }
    })();
  }
  </script>
  <%- include('partials/ecosystem_nav') %>
</body>
</html>
